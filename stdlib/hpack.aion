// ── Huffman coding ───────────────────────────────────────────────

// A tree of the codes, built once: the child of a node for a 0 bit and for a 1 bit, and the byte a leaf stands for.
trieZero := Array<Int>(1024, -1)
trieOne := Array<Int>(1024, -1)
trieByte := Array<Int>(1024, -1)

fn __buildTrie() {
    nodes := 1
    for sym in 0..256 {
        code := huffmanCodes[sym]
        n := huffmanLengths[sym]
        node := 0
        for i in 0..n {
            bit := code.shr(n - 1 - i).and(1)
            children := bit == 0 ? trieZero : trieOne
            next := children[node]
            if next < 0 {
                next = nodes
                nodes += 1
                children[node] = next
            }
            node = next
        }
        trieByte[node] = sym
    }
}
__buildTrie()

// Decode Huffman coded bytes; null if the data is not valid (a code that does not exist, the end-of-string
// code, or padding that is longer than 7 bits or not all ones).
fn huffmanDecode(data: Bytes) -> Bytes? {
    out := BytesBuilder()
    node := 0
    pending := 0
    ones := true
    for i in 0..data.size() {
        byte := data[i]
        for b in 0..8 {
            bit := byte.shr(7 - b).and(1)
            node = bit == 0 ? trieZero[node] : trieOne[node]
            if node < 0 { return null }
            pending += 1
            if bit == 0 { ones = false }
            if trieByte[node] >= 0 {
                out.addByte(trieByte[node])
                node = 0
                pending = 0
                ones = true
            }
        }
    }
    if pending > 7 || !ones { return null }
    return out.toBytes()
}

// Huffman code bytes, the last byte filled up with ones.
fn huffmanEncode(data: Bytes) -> Bytes {
    out := BytesBuilder()
    acc := 0
    bits := 0
    for i in 0..data.size() {
        sym := data[i]
        n := huffmanLengths[sym]
        acc = acc.shl(n).or(huffmanCodes[sym])
        bits += n
        while bits >= 8 {
            out.addByte(acc.shr(bits - 8).and(255))
            bits -= 8
        }
        acc = acc.and((1).shl(bits) - 1)
    }
    if bits > 0 { out.addByte(acc.shl(8 - bits).or((1).shl(8 - bits) - 1).and(255)) }
    return out.toBytes()
}

// ── Integers and strings ─────────────────────────────────────────

// Reads the numbers and strings of a header block.
type Cursor(data: Bytes) {
    pos: Int = 0

    fn atEnd() = pos >= data.size()

    // An integer with an N-bit prefix in the current byte; -1 if the block ends or the number is too large.
    fn int(prefix: Int) -> Int {
        if pos >= data.size() { return -1 }
        mask := (1).shl(prefix) - 1
        value := data[pos].and(mask)
        pos += 1
        if value < mask { return value }
        shift := 0
        while true {
            if pos >= data.size() || shift > 28 { return -1 }
            b := data[pos]
            pos += 1
            value += b.and(127).shl(shift)
            shift += 7
            if b.and(128) == 0 { return value }
        }
        return -1
    }

    // A string: a length, then that many bytes, Huffman coded if the first bit says so.
    fn string() -> String? {
        if pos >= data.size() { return null }
        coded := data[pos].and(128) != 0
        n := int(7)
        if n < 0 || pos + n > data.size() { return null }
        raw := data.slice(pos, pos + n)
        pos += n
        if !coded { return raw.toText() }
        return huffmanDecode(raw)?.toText()
    }
}

fn __putInt(out: BytesBuilder, flags: Int, prefix: Int, value: Int) {
    limit := (1).shl(prefix) - 1
    if value < limit {
        out.addByte(flags.or(value))
        return
    }
    out.addByte(flags.or(limit))
    rest := value - limit
    while rest >= 128 {
        out.addByte(rest.and(127).or(128))
        rest = rest.shr(7)
    }
    out.addByte(rest)
}

fn __putString(out: BytesBuilder, text: String, huffman: Bool) {
    raw := text.toBytes()
    if huffman {
        coded := huffmanEncode(raw)
        if coded.size() < raw.size() {
            __putInt(out, 128, 7, coded.size())
            out.add(coded)
            return
        }
    }
    __putInt(out, 0, 7, raw.size())
    out.add(raw)
}

// ── Decoder ──────────────────────────────────────────────────────

// Decodes header blocks and keeps the dynamic table the blocks of one connection share.
type Decoder(maxTableSize: Int = 4096) {
    names: List<String> = List<String>()
    values: List<String> = List<String>()
    size: Int = 0
    limit: Int = -1
    problem: String = ""

    fn entry(index: Int) -> Header? {
        if index >= 1 && index <= 61 { return Header(staticNames[index - 1], staticValues[index - 1]) }
        k := index - 62
        if k >= 0 && k < names.size() { return Header(names[k], values[k]) }
        return null
    }

    fn evict(room: Int) {
        while size > room && !names.isEmpty() {
            last := names.size() - 1
            size -= names[last].length() + values[last].length() + 32
            names.removeAt(last)
            values.removeAt(last)
        }
    }

    fn remember(h: Header) {
        cost := h.name.length() + h.value.length() + 32
        if cost > limit {
            names.clear()
            values.clear()
            size = 0
            return
        }
        evict(limit - cost)
        names.insert(0, h.name)
        values.insert(0, h.value)
        size += cost
    }

    fn fail(text: String) -> List<Header>? {
        problem = text
        return null
    }

    // The headers of one block, in order; null (and `problem`) if the block is not valid.
    fn decode(block: Bytes) -> List<Header>? {
        if limit < 0 { limit = maxTableSize }
        out := List<Header>()
        c := Cursor(block)
        while !c.atEnd() {
            first := block[c.pos]
            if first.and(128) != 0 {
                index := c.int(7)
                header := index > 0 ? entry(index) : null
                if header == null { return fail("invalid header index $index") }
                out.add(header)
            } else if first.and(32) != 0 && first.and(64) == 0 {
                newLimit := c.int(5)
                if newLimit < 0 || newLimit > maxTableSize { return fail("invalid dynamic table size") }
                limit = newLimit
                evict(limit)
            } else {
                remembered := first.and(64) != 0
                index := c.int(remembered ? 6 : 4)
                if index < 0 { return fail("truncated header block") }
                name: String? = null
                if index == 0 {
                    name = c.string()
                } else {
                    named := entry(index)
                    name = named == null ? null : named.name
                }
                value := c.string()
                if name == null || value == null { return fail("invalid header field") }
                header := Header(name, value)
                if remembered { remember(header) }
                out.add(header)
            }
        }
        return out
    }
}

// ── Encoder ──────────────────────────────────────────────────────

// Encodes header lists.  A header found whole in the static table is one byte; others are literals that
// are not added to the dynamic table (and the ones that carry secrets are marked never-indexed).  With
// `huffman` set, strings are Huffman coded where that is shorter.  Names must be in lower case.
type Encoder(huffman: Bool = true) {
    fn encode(headers: List<Header>) -> Bytes {
        out := BytesBuilder()
        for h in headers {
            whole := 0
            named := 0
            for i in 0..61 {
                if staticNames[i] == h.name {
                    if named == 0 { named = i + 1 }
                    if staticValues[i] == h.value { whole = i + 1 }
                }
            }
            if whole > 0 {
                __putInt(out, 128, 7, whole)
                continue
            }
            secret := h.name == "authorization" || h.name == "cookie" || h.name == "set-cookie"
            flags := secret ? 16 : 0
            if named > 0 {
                __putInt(out, flags, 4, named)
            } else {
                out.addByte(flags)
                __putString(out, h.name, huffman)
            }
            __putString(out, h.value, huffman)
        }
        return out.toBytes()
    }
}
