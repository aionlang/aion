// import hpack
//
//   decoder := hpack.Decoder()
//   headers := decoder.decode(block)!!            // List<Header>; the decoder keeps the dynamic table between blocks
//   encoder := hpack.Encoder()
//   block := encoder.encode([hpack.Header(":method", "GET"), hpack.Header(":path", "/")])
//
// HPACK (RFC 7541), the header compression of HTTP/2: the static and dynamic tables, integers and Huffman
// coded strings.  The decoder understands everything a server may send; the encoder never adds to the
// dynamic table (it uses the static table and literals), which every decoder accepts.

type Header(name: String, value: String) {
    fn toString() = "$name: $value"
}

