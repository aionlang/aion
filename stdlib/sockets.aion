// import sockets
//
//   server := sockets.TcpListener(8080)     // or: from sockets import TcpListener
//   server.listen(5)
//   client := server.accept()
//   client.send("Hello!")
//   data := client.receive(1024)
//   client.close()
//   server.close()
//
// Layout: the `extern fn`s below are the whole C interface (sockets.c);
// everything after them is ordinary Aion built on top.  Methods report
// failure the C way: a negative Int.

// ── C primitives ──────────────────────────────────────────────────

extern fn raw_create(domain: Int, kind: Int, protocol: Int) -> Int = "aion_socket_create"
extern fn raw_bind(fd: Int, port: Int) -> Int = "aion_socket_bind"
extern fn raw_connect(fd: Int, host: String, port: Int) -> Int = "aion_socket_connect"
extern fn raw_listen(fd: Int, backlog: Int) -> Int = "aion_socket_listen"
extern fn raw_accept(fd: Int) -> Int = "aion_socket_accept"
extern fn raw_send(fd: Int, data: String) -> Int = "aion_socket_send"
extern fn raw_recv(fd: Int, max_bytes: Int) -> String = "aion_socket_recv"
extern fn raw_close(fd: Int) -> Int = "aion_socket_close"
extern fn raw_shutdown(fd: Int, how: Int) -> Int = "aion_socket_shutdown"
extern fn raw_setopt(fd: Int, option: Int, value: Int) -> Int = "aion_socket_setopt"
extern fn raw_error() -> Int = "aion_socket_error"
extern fn raw_cleanup() = "aion_socket_cleanup"

// ── Constants ─────────────────────────────────────────────────────

fn AF_INET() = 2
fn SOCK_STREAM() = 1
fn SOCK_DGRAM() = 2
fn OPT_REUSEADDR() = 1
fn OPT_NONBLOCK() = 2
fn SHUT_RD() = 0
fn SHUT_WR() = 1
fn SHUT_RDWR() = 2

// ── TcpStream: a connected socket ─────────────────────────────────

type TcpStream(fd: Int) {
    connected: Bool = true

    // Bytes sent, or -1.
    fn send(data: String) -> Int {
        if (!connected) {
            return -1
        }
        return raw_send(fd, data)
    }

    // The data read, or "" when the peer closed the connection.
    fn receive(max_bytes: Int) -> String {
        if (!connected) {
            return ""
        }
        return raw_recv(fd, max_bytes)
    }

    fn shutdown(how: Int) = raw_shutdown(fd, how)

    fn close() -> Int {
        connected = false
        return raw_close(fd)
    }

    fn set_nonblocking(enabled: Int) = raw_setopt(fd, OPT_NONBLOCK(), enabled)

    // 1 if this is a usable socket, 0 otherwise.
    fn isValid() -> Int {
        if (fd >= 0) {
            return 1
        }
        return 0
    }
}

// ── TcpListener: a server socket ──────────────────────────────────

type TcpListener {
    fd: Int
    port: Int
    listening: Bool

    constructor(port: Int) {
        this.port = port
        this.listening = false

        sock := raw_create(AF_INET(), SOCK_STREAM(), 0)
        this.fd = sock
        if (sock < 0) {
            println("Failed to create socket")
            return
        }

        raw_setopt(sock, OPT_REUSEADDR(), 1)
        if (raw_bind(sock, port) < 0) {
            println("Failed to bind to port")
            raw_close(sock)
            this.fd = -1
        }
    }

    fn listen(backlog: Int) -> Int {
        if (fd < 0) {
            return -1
        }
        result := raw_listen(fd, backlog)
        if (result == 0) {
            listening = true
        }
        return result
    }

    // Blocks until a client connects.  Check `isValid()` on the result.
    fn accept() -> TcpStream {
        if (!listening) {
            return TcpStream(-1)
        }
        return TcpStream(raw_accept(fd))
    }

    fn close() -> Int {
        listening = false
        return raw_close(fd)
    }

    fn set_nonblocking(enabled: Int) = raw_setopt(fd, OPT_NONBLOCK(), enabled)
}

// ── TcpClient: connect to a remote server ─────────────────────────

type TcpClient {
    stream: TcpStream

    constructor(host: String, port: Int) {
        sock := raw_create(AF_INET(), SOCK_STREAM(), 0)
        if (sock < 0) {
            println("Failed to create socket")
            stream = TcpStream(-1)
            return
        }
        if (raw_connect(sock, host, port) < 0) {
            println("Failed to connect")
            raw_close(sock)
            stream = TcpStream(-1)
            return
        }
        stream = TcpStream(sock)
    }

    fn send(data: String) = stream.send(data)
    fn receive(max_bytes: Int) = stream.receive(max_bytes)
    fn close() = stream.close()
}

// ── UdpSocket ─────────────────────────────────────────────────────

type UdpSocket {
    fd: Int
    bound: Bool

    // Pass port 0 to skip binding.
    constructor(port: Int) {
        sock := raw_create(AF_INET(), SOCK_DGRAM(), 0)
        fd = sock
        bound = false
        if (sock < 0) {
            println("Failed to create UDP socket")
            return
        }
        if (port > 0) {
            if (raw_bind(sock, port) == 0) {
                bound = true
            }
        }
    }

    fn bind(port: Int) -> Int {
        if (bound) {
            return -1
        }
        result := raw_bind(fd, port)
        if (result == 0) {
            bound = true
        }
        return result
    }

    fn receive(max_bytes: Int) = raw_recv(fd, max_bytes)

    fn close() -> Int {
        bound = false
        return raw_close(fd)
    }
}

// ── Utilities ─────────────────────────────────────────────────────

fn cleanup() = raw_cleanup()

fn get_last_error() = raw_error()
