// import std.sockets;
//
//   server := sockets.TcpListener(8080)     // or: import std.sockets.TcpListener;
//   server.listen(5)
//   client := server.accept()
//   client.send("Hello!")
//   data := client.receive(1024)
//   client.close()
//   server.close()
//
// Layout: the `extern fn`s below are the whole C interface (sockets.c);
// everything after them is ordinary Aion built on top.  Methods report
// failure the C way: a negative Int.

// ── C primitives ──────────────────────────────────────────────────

extern fn raw_create(domain: Int, kind: Int, protocol: Int) -> Int = "aion_socket_create"
extern fn raw_bind(fd: Int, port: Int) -> Int = "aion_socket_bind"
extern fn raw_connect(fd: Int, host: String, port: Int) -> Int = "aion_socket_connect"
extern fn raw_listen(fd: Int, backlog: Int) -> Int = "aion_socket_listen"
extern fn raw_accept(fd: Int) -> Int = "aion_socket_accept"
extern fn raw_send(fd: Int, data: String) -> Int = "aion_socket_send"
extern fn raw_recv(fd: Int, max_bytes: Int) -> String = "aion_socket_recv"
extern fn raw_close(fd: Int) -> Int = "aion_socket_close"
extern fn raw_shutdown(fd: Int, how: Int) -> Int = "aion_socket_shutdown"
extern fn raw_setopt(fd: Int, option: Int, value: Int) -> Int = "aion_socket_setopt"
extern fn raw_error() -> Int = "aion_socket_error"
extern fn raw_cleanup() = "aion_socket_cleanup"

// ── Constants ─────────────────────────────────────────────────────

fn AF_INET() -> Int => 2
fn SOCK_STREAM() -> Int => 1
fn SOCK_DGRAM() -> Int => 2
fn OPT_REUSEADDR() -> Int => 1
fn OPT_NONBLOCK() -> Int => 2
fn SHUT_RD() -> Int => 0
fn SHUT_WR() -> Int => 1
fn SHUT_RDWR() -> Int => 2

// ── TcpStream: a connected socket ─────────────────────────────────

type TcpStream {
    fd: Int
    connected: Bool

    constructor(fd: Int) {
        it.fd = fd
        it.connected = true
    }

    // Bytes sent, or -1.
    fn send(data: String) -> Int {
        if (!it.connected) {
            return -1
        }
        return raw_send(it.fd, data)
    }

    // The data read, or "" when the peer closed the connection.
    fn receive(max_bytes: Int) -> String {
        if (!it.connected) {
            return ""
        }
        return raw_recv(it.fd, max_bytes)
    }

    fn shutdown(how: Int) -> Int {
        return raw_shutdown(it.fd, how)
    }

    fn close() -> Int {
        it.connected = false
        return raw_close(it.fd)
    }

    fn set_nonblocking(enabled: Int) -> Int {
        return raw_setopt(it.fd, OPT_NONBLOCK(), enabled)
    }

    // 1 if this is a usable socket, 0 otherwise.
    fn isValid() -> Int {
        if (it.fd >= 0) {
            return 1
        }
        return 0
    }
}

// ── TcpListener: a server socket ──────────────────────────────────

type TcpListener {
    fd: Int
    port: Int
    listening: Bool

    constructor(port: Int) {
        it.port = port
        it.listening = false

        fd := raw_create(AF_INET(), SOCK_STREAM(), 0)
        it.fd = fd
        if (fd < 0) {
            println("Failed to create socket")
            return
        }

        raw_setopt(fd, OPT_REUSEADDR(), 1)
        if (raw_bind(fd, port) < 0) {
            println("Failed to bind to port")
            raw_close(fd)
            it.fd = -1
        }
    }

    fn listen(backlog: Int) -> Int {
        if (it.fd < 0) {
            return -1
        }
        result := raw_listen(it.fd, backlog)
        if (result == 0) {
            it.listening = true
        }
        return result
    }

    // Blocks until a client connects.  Check `isValid()` on the result.
    fn accept() -> TcpStream {
        if (!it.listening) {
            return TcpStream(-1)
        }
        return TcpStream(raw_accept(it.fd))
    }

    fn close() -> Int {
        it.listening = false
        return raw_close(it.fd)
    }

    fn set_nonblocking(enabled: Int) -> Int {
        return raw_setopt(it.fd, OPT_NONBLOCK(), enabled)
    }
}

// ── TcpClient: connect to a remote server ─────────────────────────

type TcpClient {
    stream: TcpStream

    constructor(host: String, port: Int) {
        fd := raw_create(AF_INET(), SOCK_STREAM(), 0)
        if (fd < 0) {
            println("Failed to create socket")
            it.stream = TcpStream(-1)
            return
        }
        if (raw_connect(fd, host, port) < 0) {
            println("Failed to connect")
            raw_close(fd)
            it.stream = TcpStream(-1)
            return
        }
        it.stream = TcpStream(fd)
    }

    fn send(data: String) -> Int {
        return it.stream.send(data)
    }

    fn receive(max_bytes: Int) -> String {
        return it.stream.receive(max_bytes)
    }

    fn close() -> Int {
        return it.stream.close()
    }
}

// ── UdpSocket ─────────────────────────────────────────────────────

type UdpSocket {
    fd: Int
    bound: Bool

    // Pass port 0 to skip binding.
    constructor(port: Int) {
        fd := raw_create(AF_INET(), SOCK_DGRAM(), 0)
        it.fd = fd
        it.bound = false
        if (fd < 0) {
            println("Failed to create UDP socket")
            return
        }
        if (port > 0) {
            if (raw_bind(fd, port) == 0) {
                it.bound = true
            }
        }
    }

    fn bind(port: Int) -> Int {
        if (it.bound) {
            return -1
        }
        result := raw_bind(it.fd, port)
        if (result == 0) {
            it.bound = true
        }
        return result
    }

    fn receive(max_bytes: Int) -> String {
        return raw_recv(it.fd, max_bytes)
    }

    fn close() -> Int {
        it.bound = false
        return raw_close(it.fd)
    }
}

// ── Utilities ─────────────────────────────────────────────────────

fn cleanup() {
    raw_cleanup()
}

fn get_last_error() -> Int {
    return raw_error()
}
