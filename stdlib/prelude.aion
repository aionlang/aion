// The prelude: names available in every Aion program without an import.
//
// Also built in, but not expressible as ordinary functions because they
// accept any printable type (Int, Float, Bool or String):
//
//   print(value)     write the value, no newline
//   println(value)   write the value and a newline
//   println()        write just a newline

// Stop the program with `[aion] panic: <message>` on stderr and exit code 1.
extern fn panic(message: String) = "aion_panic"

// Like print and println, but to standard error (diagnostics, usage messages).
extern fn eprint(text: String) = "aion_eprint"
fn eprintln(text: String = "") {
    eprint(text + "\n")
}

// Methods on the built-in types.  "héllo".length() counts bytes.
extern fn String.length() -> Int = "aion_strings_length"
extern fn String.contains(needle: String) -> Bool = "aion_strings_contains"
extern fn String.startsWith(prefix: String) -> Bool = "aion_strings_starts_with"
extern fn String.upper() -> String = "aion_strings_upper"
extern fn String.lower() -> String = "aion_strings_lower"
// Bytes [start, end); stops the program if the range is invalid.
extern fn String.substring(start: Int, end: Int) -> String = "aion_strings_substring"
// Byte offset of the first `needle` at or after byte `from`, or -1.
extern fn __index_from(s: String, needle: String, from: Int) -> Int = "aion_strings_index_from"
fn String.indexOf(needle: String, from: Int = 0) = __index_from(this, needle, from)
extern fn String.trim() -> String = "aion_strings_trim"
extern fn String.replace(from: String, to: String) -> String = "aion_strings_replace"
// The number the text spells, or `fallback` if it is not a whole number.
extern fn String.toIntOr(fallback: Int) -> Int = "aion_strings_to_int_or"
// Is the whole text a whole number?
extern fn String.isInt() -> Bool = "aion_strings_is_int"
fn String.toIntOrNull() -> Int? = if isInt() { toIntOr(0) } else { null }

// The number the text spells, or `fallback` if it is not a decimal number such as "3.5" or "1e-3".
extern fn String.toFloatOr(fallback: Float) -> Float = "aion_strings_to_float_or"
extern fn String.isFloat() -> Bool = "aion_strings_is_float"
fn String.toFloatOrNull() -> Float? = if isFloat() { toFloatOr(0.0) } else { null }
// The number the text spells in a base from 2 to 36 ("ff".parseInt(16) is 255), or null.
fn String.parseInt(radix: Int) -> Int? {
    if radix < 2 || radix > 36 || length() == 0 {
        return null
    }
    negative := startsWith("-")
    at := if negative || startsWith("+") { 1 } else { 0 }
    if at == length() {
        return null
    }
    value := 0
    while at < length() {
        c := lower().charAt(at)
        digit := if c >= '0' && c <= '9' { c - '0' } else if c >= 'a' && c <= 'z' { c - 'a' + 10 } else { 99 }
        if digit >= radix {
            return null
        }
        value = value * radix + digit
        at += 1
    }
    return if negative { -value } else { value }
}

extern fn String.endsWith(suffix: String) -> Bool = "aion_strings_ends_with"
// Byte offset of the last `needle`, or -1.
extern fn String.lastIndexOf(needle: String) -> Int = "aion_strings_last_index_of"
extern fn String.trimStart() -> String = "aion_strings_trim_start"
extern fn String.trimEnd() -> String = "aion_strings_trim_end"
// "ab".repeat(3) is "ababab".
extern fn String.repeat(times: Int) -> String = "aion_strings_repeat"
// How many characters (not bytes) the text has.
extern fn String.charCount() -> Int = "aion_strings_char_count"
extern fn __pad(text: String, width: Int, fill: String, left: Bool) -> String = "aion_strings_pad"
// Fill up to `width` characters: "7".padLeft(3, "0") is "007", "ab".padRight(4) is "ab  ".
fn String.padLeft(width: Int, fill: String = " ") = __pad(this, width, fill, true)
fn String.padRight(width: Int, fill: String = " ") = __pad(this, width, fill, false)
fn String.isEmpty() = length() == 0
fn String.isBlank() = trim().length() == 0

// The character that starts at byte `index`.  s[i] is the same.
extern fn String.charAt(index: Int) -> Char = "aion_str_char_at"
fn String.get(index: Int) = charAt(index)

// The characters of the text; `for c in text` loops over them.
fn String.chars() -> List<Char> {
    out := List<Char>()
    at := 0
    end := length()
    while at < end {
        c := charAt(at)
        out.add(c)
        at += c.byteLength()
    }
    return out
}
fn String.iter() = chars()

// s[from..to] is the text between two byte offsets; size() is the length in bytes.
fn String.size() = length()
fn String.slice(from: Int, to: Int) = substring(from, to)

fn String.split(separator: String) -> List<String> {
    parts := List<String>()
    if separator.length() == 0 {
        parts.add(this)
        return parts
    }
    rest := this
    at := rest.indexOf(separator)
    while at >= 0 {
        parts.add(rest.substring(0, at))
        rest = rest.substring(at + separator.length(), rest.length())
        at = rest.indexOf(separator)
    }
    parts.add(rest)
    return parts
}

// ── Numbers ─────────────────────────────────────────────────────

// Int and Float convert only where you say so: n.toFloat(), x.toInt().
fn Int.toFloat() -> Float = this + 0.0
fn Int.toString() -> String = "$this"
fn Float.toString() -> String = "$this"
fn Bool.toString() -> String = "$this"
// Drops the fraction (towards zero); too-large values stop at the limits of Int, NaN stops the program.
extern fn Float.toInt() -> Int = "aion_float_to_int"
// Nearest whole number (halves go away from zero), and the next whole number down / up.
extern fn Float.round() -> Int = "aion_float_round"
extern fn Float.floor() -> Int = "aion_float_floor"
extern fn Float.ceil() -> Int = "aion_float_ceil"
extern fn Float.isNaN() -> Bool = "aion_float_is_nan"
extern fn Float.isInfinite() -> Bool = "aion_float_is_inf"
// 3.14159.format(2) is "3.14", 2.34567.roundTo(2) is 2.35 (decimal ties round to even, like printf).
extern fn Float.format(decimals: Int) -> String = "aion_float_format"
extern fn Float.roundTo(decimals: Int) -> Float = "aion_float_round_to"

fn Int.abs() = if this < 0 { -this } else { this }
fn Float.abs() = if this < 0.0 { -this } else { this }
fn Int.sign() = if this < 0 { -1 } else if this > 0 { 1 } else { 0 }
fn Float.sign() = if this < 0.0 { -1 } else if this > 0.0 { 1 } else { 0 }
fn Int.min(other: Int) = if other < this { other } else { this }
fn Int.max(other: Int) = if other > this { other } else { this }
fn Float.min(other: Float) = if other < this { other } else { this }
fn Float.max(other: Float) = if other > this { other } else { this }
// The number, or `low` / `high` if it lies outside them.
fn Int.clamp(low: Int, high: Int) = if this < low { low } else if this > high { high } else { this }
fn Float.clamp(low: Float, high: Float) = if this < low { low } else if this > high { high } else { this }

// n.pow(k) for k >= 0, wrapping on overflow like all Int arithmetic.
fn Int.pow(exponent: Int) -> Int {
    if exponent < 0 {
        panic("pow needs a non-negative exponent")
    }
    result := 1
    base := this
    e := exponent
    while e > 0 {
        if e % 2 == 1 {
            result *= base
        }
        base *= base
        e /= 2
    }
    return result
}

// The largest number that divides both (always non-negative).
fn Int.gcd(other: Int) -> Int {
    a := abs()
    b := other.abs()
    while b != 0 {
        t := a % b
        a = b
        b = t
    }
    return a
}

// The digits in another base, 2 to 36: 255.toRadix(16) is "ff".
extern fn Int.toRadix(radix: Int) -> String = "aion_int_to_radix"
fn Int.toHex() = toRadix(16)
fn Int.toBinary() = toRadix(2)

// The lines of the text, without their line breaks (\n or \r\n); a final line break adds no empty line.
fn String.lines() -> List<String> {
    if length() == 0 {
        return List<String>()
    }
    parts := replace("\r\n", "\n").split("\n")
    if parts[parts.size() - 1].length() == 0 {
        parts.pop()
    }
    return parts
}

// ── Characters ──────────────────────────────────────────────────
//
// A Char is a Unicode code point: 'a', '\n', '\u{1F600}'.  c + 1 and c - 1 are
// Chars, c - 'a' is an Int.  Letter classification and case are exact for ASCII,
// Latin-1, Greek and Cyrillic and a rule of thumb elsewhere.

extern fn Char.isDigit() -> Bool = "aion_char_is_digit"
extern fn Char.isLetter() -> Bool = "aion_char_is_letter"
extern fn Char.isUpper() -> Bool = "aion_char_is_upper"
extern fn Char.isLower() -> Bool = "aion_char_is_lower"
extern fn Char.isWhitespace() -> Bool = "aion_char_is_space"
extern fn Char.upper() -> Char = "aion_char_upper"
extern fn Char.lower() -> Char = "aion_char_lower"
// How many bytes the character takes in a String (UTF-8).
extern fn Char.byteLength() -> Int = "aion_char_utf8_len"
extern fn Char.toString() -> String = "aion_char_to_str"

fn Char.code() = this - '\0'
fn Int.toChar() = '\0' + this
// 0..9 for a digit, else null.
fn Char.digitValue() -> Int? = if isDigit() { this - '0' } else { null }

// ── Bytes ───────────────────────────────────────────────────────

// Raw bytes, as read from a file or a socket.  `Bytes(8)` is eight zero bytes,
// `Bytes(8, 255)` eight 0xFF; b[i] is a number from 0 to 255 and b.size() the length.
// Two Bytes are == when they hold the same bytes, and they work as Map keys.
extern fn __bytes_make(size: Int, fill: Int) -> Bytes = "aion_bytes_make"
fn Bytes(size: Int, fill: Int = 0) = __bytes_make(size, fill)

extern fn Bytes.size() -> Int = "aion_bytes_size"
extern fn Bytes.get(index: Int) -> Int = "aion_bytes_get"
extern fn Bytes.set(index: Int, value: Int) = "aion_bytes_set"
// b[from..to] is a copy of those bytes.
extern fn Bytes.slice(from: Int, to: Int) -> Bytes = "aion_bytes_slice"
extern fn Bytes.concat(other: Bytes) -> Bytes = "aion_bytes_concat"
extern fn __bytes_index_of(b: Bytes, value: Int, from: Int) -> Int = "aion_bytes_index_of"
// The position of the first byte equal to `value` at or after `from`, or -1.
fn Bytes.indexOf(value: Int, from: Int = 0) = __bytes_index_of(this, value, from)
fn Bytes.contains(value: Int) = indexOf(value) >= 0

// Lower-case hex, two digits per byte; and back (null if the text is not hex).
extern fn Bytes.toHex() -> String = "aion_bytes_to_hex"
extern fn String.fromHex() -> Bytes? = "aion_bytes_from_hex"
// The UTF-8 text in the bytes (up to the first zero byte); and the bytes of a text.
extern fn Bytes.toText() -> String = "aion_bytes_to_str"
extern fn String.toBytes() -> Bytes = "aion_str_to_bytes"

fn Bytes.toList() -> List<Int> {
    out := List<Int>()
    for i in 0..size() {
        out.add(get(i))
    }
    return out
}
fn Bytes.iter() = toList()

// The bytes with the given values (each 0 to 255).
fn bytesOf(values: List<Int>) -> Bytes {
    out := Bytes(values.size())
    for i in 0..values.size() {
        out[i] = values[i]
    }
    return out
}

// bytes[at..at+count] = src[from..from+count]; the ranges must lie inside both.
extern fn Bytes.copyFrom(at: Int, src: Bytes, from: Int, count: Int) = "aion_bytes_copy"
// Write the UTF-8 bytes of the text into the Bytes, starting at `at`.
extern fn Bytes.putText(at: Int, text: String) = "aion_bytes_put"
extern fn __bytes_text(b: Bytes, from: Int, to: Int) -> String = "aion_bytes_text"

// Position of the first occurrence of `needle` at or after `from`, or -1.
extern fn __bytes_find(b: Bytes, needle: Bytes, from: Int) -> Int = "aion_bytes_find"
fn Bytes.find(needle: Bytes, from: Int = 0) = __bytes_find(this, needle, from)
fn Bytes.startsWith(prefix: Bytes) = prefix.size() <= size() && slice(0, prefix.size()) == prefix

extern fn __bytes_equals(a: Bytes, b: Bytes) -> Bool = "aion_bytes_equals"
extern fn __bytes_hash(b: Bytes) -> Int = "aion_bytes_hash"
fn __bytes_str(b: Bytes) -> String = "Bytes(${b.toHex()})"

// ── StringBuilder ───────────────────────────────────────────────

// Builds text piece by piece, without copying everything built so far for each piece
// (which `text += piece` in a loop does).
//
//   sb := StringBuilder()
//   for i in 0..1000 { sb.append("line ").append("$i").appendLine() }
//   println(sb.length(), sb.toString().lines().size())
type StringBuilder {
    data: Bytes = Bytes(32)
    used: Int

    // How many bytes have been added.
    fn length() = used
    fn isEmpty() = used == 0

    fn reserve(extra: Int) {
        need := used + extra
        if need > data.size() {
            capacity := data.size() * 2
            if capacity < need {
                capacity = need
            }
            bigger := Bytes(capacity)
            bigger.copyFrom(0, data, 0, used)
            data = bigger
        }
    }

    fn append(text: String) -> StringBuilder {
        reserve(text.length())
        data.putText(used, text)
        used += text.length()
        return this
    }
    fn appendChar(c: Char) -> StringBuilder = append(c.toString())
    fn appendLine(text: String = "") -> StringBuilder {
        append(text)
        return append("\n")
    }

    // Forget everything; or keep only the first `length` bytes.
    fn clear() { used = 0 }
    fn truncate(length: Int) {
        if length < 0 || length > used {
            panic("truncate(${length}) is out of range for length $used")
        }
        used = length
    }

    fn toString() = __bytes_text(data, 0, used)
}

// ── BytesBuilder ────────────────────────────────────────────────

// Collects bytes piece by piece, like StringBuilder does for text.
type BytesBuilder {
    data: Bytes = Bytes(64)
    used: Int

    fn size() = used
    fn isEmpty() = used == 0

    fn reserve(extra: Int) {
        need := used + extra
        if need > data.size() {
            capacity := data.size() * 2
            if capacity < need {
                capacity = need
            }
            bigger := Bytes(capacity)
            bigger.copyFrom(0, data, 0, used)
            data = bigger
        }
    }

    fn add(bytes: Bytes) -> BytesBuilder {
        reserve(bytes.size())
        data.copyFrom(used, bytes, 0, bytes.size())
        used += bytes.size()
        return this
    }
    fn addText(text: String) -> BytesBuilder {
        reserve(text.length())
        data.putText(used, text)
        used += text.length()
        return this
    }
    fn addByte(value: Int) -> BytesBuilder {
        reserve(1)
        data[used] = value
        used += 1
        return this
    }

    fn clear() { used = 0 }
    // Everything collected so far, as a Bytes of its own.
    fn toBytes() = data.slice(0, used)
    // Position of the first `needle` at or after `from` among the bytes collected, or -1.
    fn find(needle: Bytes, from: Int = 0) -> Int {
        at := data.find(needle, from)
        return if at >= 0 && at + needle.size() <= used { at } else { -1 }
    }
    // Remove and return the first `count` bytes.
    fn take(count: Int) -> Bytes {
        if count < 0 || count > used {
            panic("take(${count}) is out of range for size $used")
        }
        out := data.slice(0, count)
        dropFirst(count)
        return out
    }
    // The first `count` bytes are gone (they were used up); the rest stays.
    fn dropFirst(count: Int) {
        if count < 0 || count > used {
            panic("dropFirst(${count}) is out of range for size $used")
        }
        data.copyFrom(0, data, count, used - count)
        used -= count
    }
    fn toString() = "BytesBuilder($used bytes)"
}

// ── Ordering ────────────────────────────────────────────────────

// Things that can be put in order: a.compareTo(b) is negative, zero or positive.
// Any type with a matching compareTo qualifies, e.g. `fn compareTo(other: Version) = …`.
interface Comparable<T> { fn compareTo(other: T) -> Int }

fn Int.compareTo(other: Int) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn Float.compareTo(other: Float) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn String.compareTo(other: String) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn Char.compareTo(other: Char) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn Bool.compareTo(other: Bool) = if this == other { 0 } else if this { 1 } else { -1 }

// ── Collections ─────────────────────────────────────────────────
//
// `Array<T>` is built into the compiler: a fixed-size block of slots with
// size(), get(i), set(i, v) and clear(i), also written a[i] and a[i] = v.
// Everything below is ordinary Aion built on top of it.
//
// Conventions the compiler relies on (so your own types can join in):
//   x[i]        calls  x.get(i)         x[i] = v   calls  x.set(i, v)
//   a in x      calls  x.contains(a)
//   for v in x  uses   x.size() and x.get(i), or loops over x.iter() if there is one
//   [a, b]      is a List,  {k: v} is a Map

// A growable list.
type List<T> {
    items: Array<T> = Array<T>(8)
    count: Int

    fn size() = count
    fn isEmpty() = count == 0

    fn get(index: Int) -> T {
        checkIndex(index)
        return items[index]
    }
    fn set(index: Int, value: T) {
        checkIndex(index)
        items[index] = value
    }
    fn checkIndex(index: Int) {
        if index < 0 || index >= count {
            panic("index $index is out of bounds for size $count")
        }
    }

    fn add(value: T) {
        if count == items.size() {
            bigger := Array<T>(count * 2)
            for i in 0..count { bigger[i] = items[i] }
            items = bigger
        }
        items[count] = value
        count += 1
    }
    fn addAll(other: List<T>) {
        for x in other { add(x) }
    }
    // `a + b` is a new list holding the elements of both.
    fn plus(other: List<T>) -> List<T> {
        out := copy()
        out.addAll(other)
        return out
    }
    fn removeAt(index: Int) -> T {
        checkIndex(index)
        removed := items[index]
        for i in index..count - 1 { items[i] = items[i + 1] }
        count -= 1
        items.clear(count)
        return removed
    }
    fn pop() -> T = removeAt(count - 1)
    fn clear() {
        for i in 0..count { items.clear(i) }
        count = 0
    }

    fn first() -> T = get(0)
    fn last() -> T = get(count - 1)
    fn getOrNull(index: Int) -> T? {
        if index < 0 || index >= count { return null }
        return items[index]
    }
    fn firstOrNull() -> T? = getOrNull(0)
    fn lastOrNull() -> T? = getOrNull(count - 1)
    // The first element that passes `test`, or null.
    fn find(test: (T) -> Bool) -> T? {
        for i in 0..count {
            if test(items[i]) { return items[i] }
        }
        return null
    }

    fn contains(value: T) = indexOf(value) >= 0
    fn indexOf(value: T) -> Int {
        for i in 0..count {
            if items[i] == value { return i }
        }
        return -1
    }

    fn copy() -> List<T> {
        out := List<T>()
        for x in this { out.add(x) }
        return out
    }
    fn reversed() -> List<T> {
        out := List<T>()
        for i in 0..count { out.add(items[count - 1 - i]) }
        return out
    }
    // The elements from `from` up to (not including) `to`: xs[from..to].
    fn slice(from: Int, to: Int) -> List<T> {
        if from < 0 || to > count || from > to {
            panic("slice bounds [$from..$to] are out of range for size $count")
        }
        out := List<T>()
        for i in from..to { out.add(items[i]) }
        return out
    }
    fn take(n: Int) -> List<T> {
        out := List<T>()
        for i in 0..count {
            if i < n { out.add(items[i]) }
        }
        return out
    }
    fn drop(n: Int) -> List<T> {
        out := List<T>()
        for i in n..count { out.add(items[i]) }
        return out
    }

    fn forEach(f: (T) -> Unit) {
        for i in 0..count { f(items[i]) }
    }
    fn map<R>(f: (T) -> R) -> List<R> {
        out := List<R>()
        for i in 0..count { out.add(f(items[i])) }
        return out
    }
    fn filter(keep: (T) -> Bool) -> List<T> {
        out := List<T>()
        for i in 0..count {
            if keep(items[i]) { out.add(items[i]) }
        }
        return out
    }
    // Pairs up the elements of two lists, as long as the shorter one: [(1, "a"), (2, "b")].
    fn zip<U>(other: List<U>) -> List<(T, U)> {
        out := List<(T, U)>()
        n := count
        if other.count < n { n = other.count }
        for i in 0..n { out.add((items[i], other.items[i])) }
        return out
    }
    // The first elements, so that `a, b := list` works.
    fn component1() -> T = get(0)
    fn component2() -> T = get(1)
    fn component3() -> T = get(2)
    fn component4() -> T = get(3)
    fn component5() -> T = get(4)
    fn fold<R>(initial: R, f: (R, T) -> R) -> R {
        acc := initial
        for i in 0..count { acc = f(acc, items[i]) }
        return acc
    }
    fn reduce(f: (T, T) -> T) -> T {
        if count == 0 { panic("reduce of an empty list") }
        acc := items[0]
        for i in 1..count { acc = f(acc, items[i]) }
        return acc
    }
    fn any(test: (T) -> Bool) -> Bool {
        for i in 0..count {
            if test(items[i]) { return true }
        }
        return false
    }
    fn all(test: (T) -> Bool) -> Bool {
        for i in 0..count {
            if !test(items[i]) { return false }
        }
        return true
    }
    fn count(test: (T) -> Bool) -> Int {
        n := 0
        for i in 0..count {
            if test(items[i]) { n += 1 }
        }
        return n
    }

    // A new list, sorted by `compare(a, b)`: negative if a goes first, positive if b does.
    // A stable natural merge sort in the style of Timsort, O(n log n): it finds the runs already in the
    // data (ascending, or strictly descending and then reversed), grows short ones to 32 elements with a
    // binary insertion sort, and merges neighbouring runs.  Sorted or reversed input takes about n comparisons.
    fn sortedWith(compare: (T, T) -> Int) -> List<T> {
        n := count
        src := Array<T>(n)
        for i in 0..n { src[i] = items[i] }

        // The runs: run r is src[bounds[r] until bounds[r + 1]].
        bounds := List<Int>()
        lo := 0
        while lo < n {
            hi := lo + 1
            if hi < n {
                if compare(src[hi], src[lo]) < 0 {
                    while hi < n && compare(src[hi], src[hi - 1]) < 0 { hi += 1 }
                    left := lo
                    right := hi - 1
                    while left < right {
                        t := src[left]
                        src[left] = src[right]
                        src[right] = t
                        left += 1
                        right -= 1
                    }
                } else {
                    while hi < n && compare(src[hi], src[hi - 1]) >= 0 { hi += 1 }
                }
            }
            if hi - lo < 32 && hi < n {
                end := if lo + 32 < n { lo + 32 } else { n }
                for i in hi..end {
                    x := src[i]
                    a := lo
                    b := i
                    while a < b {
                        m := (a + b) / 2
                        if compare(x, src[m]) < 0 { b = m } else { a = m + 1 }
                    }
                    j := i
                    while j > a {
                        src[j] = src[j - 1]
                        j -= 1
                    }
                    src[a] = x
                }
                hi = end
            }
            bounds.add(lo)
            lo = hi
        }
        bounds.add(n)

        // Merge neighbouring runs, pass by pass, until one is left.
        spare := Array<T>(n)
        while bounds.size() > 2 {
            next := List<Int>()
            r := 0
            while r + 1 < bounds.size() {
                first := bounds[r]
                if r + 2 >= bounds.size() {
                    for k in first..n { spare[k] = src[k] }
                    next.add(first)
                    r += 1
                } else {
                    mid := bounds[r + 1]
                    hi := bounds[r + 2]
                    i := first
                    j := mid
                    k := first
                    if compare(src[mid], src[mid - 1]) >= 0 {
                        while k < hi {
                            spare[k] = src[k]
                            k += 1
                        }
                    } else {
                        while i < mid && j < hi {
                            if compare(src[j], src[i]) < 0 {
                                spare[k] = src[j]
                                j += 1
                            } else {
                                spare[k] = src[i]
                                i += 1
                            }
                            k += 1
                        }
                        while i < mid {
                            spare[k] = src[i]
                            i += 1
                            k += 1
                        }
                        while j < hi {
                            spare[k] = src[j]
                            j += 1
                            k += 1
                        }
                    }
                    next.add(first)
                    r += 2
                }
            }
            next.add(n)
            bounds = next
            done := spare
            spare = src
            src = done
        }
        out := List<T>()
        for i in 0..n { out.add(src[i]) }
        return out
    }

    // Ordered by compareTo (the elements must have one); sortedBy orders by a key.
    fn sorted() -> List<T> = sortedWith { a, b -> a.compareTo(b) }
    fn sortedDescending() -> List<T> = sortedWith { a, b -> b.compareTo(a) }
    fn sortedBy<K: Comparable<K>>(key: (T) -> K) -> List<T> = sortedWith { a, b -> key(a).compareTo(key(b)) }
    fn maxOrNull() -> T? {
        if count == 0 { return null }
        best := items[0]
        for i in 1..count {
            if items[i].compareTo(best) > 0 { best = items[i] }
        }
        return best
    }
    fn minOrNull() -> T? {
        if count == 0 { return null }
        best := items[0]
        for i in 1..count {
            if items[i].compareTo(best) < 0 { best = items[i] }
        }
        return best
    }

    fn join(separator: String = ", ") -> String {
        out := StringBuilder()
        for i in 0..count {
            if i > 0 { out.append(separator) }
            out.append("${items[i]}")
        }
        return out.toString()
    }
    fn toString() = "[" + join() + "]"
}

// Tuples: `(1, "a")` is a Tuple2<Int, String>, written `(Int, String)` in types.  Up to five
// elements; a value is taken apart with `a, b := pair` (through `component1()`, `component2()`, …).
type Tuple2<A, B>(first: A, second: B) {
    fn component1() = first
    fn component2() = second
    fn equals(other: Tuple2<A, B>) = first == other.first && second == other.second
    fn hashCode() = hashOf(first) * 31 % 1000003 + hashOf(second)
    fn toString() = "($first, $second)"
}

type Tuple3<A, B, C>(first: A, second: B, third: C) {
    fn component1() = first
    fn component2() = second
    fn component3() = third
    fn equals(other: Tuple3<A, B, C>) = first == other.first && second == other.second && third == other.third
    fn hashCode() = ((hashOf(first)) * 31 % 1000003 + hashOf(second)) * 31 % 1000003 + hashOf(third)
    fn toString() = "($first, $second, $third)"
}

type Tuple4<A, B, C, D>(first: A, second: B, third: C, fourth: D) {
    fn component1() = first
    fn component2() = second
    fn component3() = third
    fn component4() = fourth
    fn equals(other: Tuple4<A, B, C, D>) = first == other.first && second == other.second && third == other.third && fourth == other.fourth
    fn hashCode() = (((hashOf(first)) * 31 % 1000003 + hashOf(second)) * 31 % 1000003 + hashOf(third)) * 31 % 1000003 + hashOf(fourth)
    fn toString() = "($first, $second, $third, $fourth)"
}

type Tuple5<A, B, C, D, E>(first: A, second: B, third: C, fourth: D, fifth: E) {
    fn component1() = first
    fn component2() = second
    fn component3() = third
    fn component4() = fourth
    fn component5() = fifth
    fn equals(other: Tuple5<A, B, C, D, E>) = first == other.first && second == other.second && third == other.third && fourth == other.fourth && fifth == other.fifth
    fn hashCode() = ((((hashOf(first)) * 31 % 1000003 + hashOf(second)) * 31 % 1000003 + hashOf(third)) * 31 % 1000003 + hashOf(fourth)) * 31 % 1000003 + hashOf(fifth)
    fn toString() = "($first, $second, $third, $fourth, $fifth)"
}

// Each element with its position: `for i, x in enumerate(xs)`.
fn enumerate<T>(xs: List<T>) -> List<(Int, T)> {
    out := List<(Int, T)>()
    for i in 0..xs.size() { out.add((i, xs[i])) }
    return out
}

// A run of Ints: `1..5` (up to, not including, 5), `1..=5`, `(0..10) step 2`, `10 downTo 0`.  It can be
// looped over, tested with `in`, and used like a list of its numbers.  (`for i in a..b` itself does not
// build one.)
type Range(start: Int, end: Int, stride: Int = 1) {
    init {
        if stride == 0 { panic("a range cannot step by 0") }
    }

    fn size() -> Int {
        if stride > 0 {
            if end <= start { return 0 }
            return (end - start + stride - 1) / stride
        }
        if start <= end { return 0 }
        return (start - end - stride - 1) / (-stride)
    }
    fn isEmpty() = size() == 0
    fn get(index: Int) -> Int {
        if index < 0 || index >= size() { panic("index $index is out of bounds for a range of ${size()} numbers") }
        return start + index * stride
    }
    fn first() -> Int = get(0)
    fn last() -> Int = get(size() - 1)
    fn contains(x: Int) -> Bool {
        if stride > 0 { return x >= start && x < end && (x - start) % stride == 0 }
        return x <= start && x > end && (start - x) % (-stride) == 0
    }
    // Every n-th number: `(0..10).step(2)`, also written `0..10 step 2`.
    fn step(n: Int) -> Range {
        if n <= 0 { panic("a step must be positive") }
        return Range(start, end, stride * n)
    }
    fn reversed() -> Range {
        if size() == 0 { return Range(0, 0) }
        return Range(last(), start - (stride > 0 ? 1 : -1), -stride)
    }
    fn toList() -> List<Int> {
        out := List<Int>()
        n := size()
        for i in 0..n { out.add(start + i * stride) }
        return out
    }
    fn sum() -> Int {
        total := 0
        n := size()
        for i in 0..n { total += start + i * stride }
        return total
    }
    fn forEach(f: (Int) -> Unit) = toList().forEach(f)
    fn map<R>(f: (Int) -> R) -> List<R> = toList().map(f)
    fn filter(keep: (Int) -> Bool) -> List<Int> = toList().filter(keep)
    fn fold<R>(initial: R, f: (R, Int) -> R) -> R = toList().fold(initial, f)
    fn any(test: (Int) -> Bool) -> Bool = toList().any(test)
    fn all(test: (Int) -> Bool) -> Bool = toList().all(test)
    fn count(test: (Int) -> Bool) -> Int = toList().count(test)
    fn join(separator: String = ", ") = toList().join(separator)
    fn toString() = toList().toString()
}

// `10 downTo 1`: the numbers from 10 down to (and including) 1.
fn Int.downTo(end: Int) = Range(this, end - 1, -1)

// One key/value pair of a Map.
type Entry<K, V>(key: K, value: V) {
    fn component1() = key
    fn component2() = value
    fn toString() = "$key: $value"
}

// A hash map that remembers insertion order.  Keys are compared with `==`
// (objects by identity) and hashed by `hashOf`.
type Map<K, V> {
    keyArr: Array<K> = Array<K>(8)
    valArr: Array<V> = Array<V>(8)
    live: Array<Bool> = Array<Bool>(8)
    // open-addressing table of entry numbers; -1 is an empty slot
    table: Array<Int> = Array(16, -1)
    used: Int
    count: Int

    fn size() = count
    fn isEmpty() = count == 0

    // Entry number of `key`, or -1.
    fn find(key: K) -> Int {
        slot := hashOf(key) % table.size()
        while table[slot] != -1 {
            e := table[slot]
            if live[e] && keyArr[e] == key { return e }
            slot = (slot + 1) % table.size()
        }
        return -1
    }

    fn containsKey(key: K) = find(key) >= 0
    fn contains(key: K) = find(key) >= 0

    fn get(key: K) -> V {
        e := find(key)
        if e < 0 { panic("no such key: $key") }
        return valArr[e]
    }
    fn getOrNull(key: K) -> V? {
        e := find(key)
        if e < 0 { return null }
        return valArr[e]
    }
    fn getOr(key: K, fallback: V) -> V {
        e := find(key)
        if e < 0 { return fallback }
        return valArr[e]
    }

    fn set(key: K, value: V) {
        e := find(key)
        if e >= 0 {
            valArr[e] = value
            return
        }
        if used == keyArr.size() {
            capacity := keyArr.size()
            if count * 2 >= capacity { capacity *= 2 }
            rebuild(capacity)
        }
        keyArr[used] = key
        valArr[used] = value
        live[used] = true
        place(used)
        used += 1
        count += 1
    }

    // Is `key` there? Removes it and says whether it was.
    fn remove(key: K) -> Bool {
        e := find(key)
        if e < 0 { return false }
        live[e] = false
        keyArr.clear(e)
        valArr.clear(e)
        count -= 1
        return true
    }

    fn clear() {
        keyArr = Array<K>(8)
        valArr = Array<V>(8)
        live = Array<Bool>(8)
        table = Array(16, -1)
        used = 0
        count = 0
    }

    // Put entry `e` in the first free table slot after its hash.
    fn place(e: Int) {
        slot := hashOf(keyArr[e]) % table.size()
        while table[slot] != -1 { slot = (slot + 1) % table.size() }
        table[slot] = e
    }

    // Copy the live entries into fresh arrays with room for `capacity` entries.
    fn rebuild(capacity: Int) {
        oldKeys := keyArr
        oldVals := valArr
        oldLive := live
        oldUsed := used
        keyArr = Array<K>(capacity)
        valArr = Array<V>(capacity)
        live = Array<Bool>(capacity)
        table = Array(capacity * 2, -1)
        used = 0
        for i in 0..oldUsed {
            if oldLive[i] {
                keyArr[used] = oldKeys[i]
                valArr[used] = oldVals[i]
                live[used] = true
                place(used)
                used += 1
            }
        }
    }

    fn keys() -> List<K> {
        out := List<K>()
        for i in 0..used {
            if live[i] { out.add(keyArr[i]) }
        }
        return out
    }
    fn values() -> List<V> {
        out := List<V>()
        for i in 0..used {
            if live[i] { out.add(valArr[i]) }
        }
        return out
    }
    fn entries() -> List<Entry<K, V>> {
        out := List<Entry<K, V>>()
        for i in 0..used {
            if live[i] { out.add(Entry(keyArr[i], valArr[i])) }
        }
        return out
    }
    fn iter() = entries()

    fn forEach(f: (K, V) -> Unit) {
        for i in 0..used {
            if live[i] { f(keyArr[i], valArr[i]) }
        }
    }

    fn toString() = "{" + entries().join() + "}"
}

// A set of distinct values, in insertion order.
type Set<T> {
    members: Map<T, Bool> = Map<T, Bool>()

    fn size() = members.size()
    fn isEmpty() = members.isEmpty()
    fn contains(value: T) = members.containsKey(value)
    // Adds `value`; says whether it was new.
    fn add(value: T) -> Bool {
        had := members.containsKey(value)
        members.set(value, true)
        return !had
    }
    fn remove(value: T) = members.remove(value)
    fn clear() { members.clear() }
    fn toList() = members.keys()
    fn iter() = members.keys()
    fn toString() = "{" + members.keys().join() + "}"
}

// The distinct values of a list.  (A function rather than a List method:
// List's methods are declared whenever a List is, and one that mentioned Set
// would pull in Map, which mentions List again, for ever.)
fn setOf<T>(items: List<T>) -> Set<T> {
    out := Set<T>()
    for x in items { out.add(x) }
    return out
}

// ── Standard input ──────────────────────────────────────────────

// The next line of input without its line break, or null when the input has ended.
// Output printed so far is flushed first, so `print("name? ")` shows before it waits.
extern fn readLine() -> String? = "aion_read_line"
// All the remaining input as one String ("" if there is none).
extern fn readText() -> String = "aion_read_text"

// ── Program arguments ───────────────────────────────────────────

extern fn __argc() -> Int = "aion_argc"
extern fn __argv(index: Int) -> String = "aion_argv"

// The command-line arguments after the script: `aion script.aion a b` gives ["a", "b"].
fn args() -> List<String> {
    out := List<String>()
    for i in 0..__argc() { out.add(__argv(i)) }
    return out
}

// ── Tasks ───────────────────────────────────────────────────────
//
// Tasks are cooperative: they run one at a time and switch only when a task waits
// (join, await, a channel, sleep) or calls yield(), so no locks are needed.  A panic in a
// task that does not `try` it ends the program.  The program ends when the main code
// does, even if tasks are still going; use waitAll() to let them finish.

extern fn __spawn(body: () -> Unit) = "aion_spawn"
extern fn __park() = "aion_park"
extern fn __notify() = "aion_notify"
extern fn __taskCount() -> Int = "aion_task_count"

// Let the other tasks run for a while.
extern fn yield() = "aion_yield"
// Pause this task for `ms` milliseconds; the others keep running.
extern fn sleep(ms: Int) = "aion_sleep"

// A task that was started with launch { … }.
type Job {
    done: Bool = false
    fn isDone() = done
    // Wait for it to finish.
    fn join() {
        while !done { __park() }
    }
}

// Run `body` as a task, concurrently with the code that follows.
fn launch(body: () -> Unit) -> Job {
    job := Job()
    __spawn({
        body()
        job.done = true
        __notify()
    })
    return job
}

// A task that produces a value.
type Task<T> {
    slot: Array<T> = Array<T>(1)
    done: Bool = false
    fn isDone() = done
    // Wait for the result.
    fn await() -> T {
        while !done { __park() }
        return slot[0]
    }
}

// Run `body` as a task and get its result later with await().
fn async<T>(body: () -> T) -> Task<T> {
    task := Task<T>()
    __spawn({
        task.slot[0] = body()
        task.done = true
        __notify()
    })
    return task
}

// Wait until every task has finished.
fn waitAll() {
    while __taskCount() > 1 { __park() }
}

// A queue for passing values from one task to another.
//
//   Channel<T>()      a send waits until a receiver has taken the value
//   Channel<T>(10)    holds up to 10 values; a send waits only when it is full
//
// receive() waits for the next value and gives null once the channel is closed and empty.
type Channel<T>(capacity: Int = 0) {
    queue: List<T> = List<T>()
    closed: Bool = false
    sent: Int = 0
    taken: Int = 0

    fn size() = queue.size()
    fn isClosed() = closed

    fn send(value: T) {
        limit := if capacity > 0 { capacity } else { 1 }
        while !closed && queue.size() >= limit { __park() }
        if closed { panic("send on a closed channel") }
        queue.add(value)
        sent += 1
        ticket := sent
        __notify()
        if capacity == 0 {
            while !closed && taken < ticket { __park() }
        }
    }

    fn receive() -> T? {
        while queue.isEmpty() && !closed { __park() }
        if queue.isEmpty() { return null }
        value := queue.removeAt(0)
        taken += 1
        __notify()
        return value
    }

    // The next value if there is one right now, else null (it never waits).
    fn tryReceive() -> T? {
        if queue.isEmpty() { return null }
        value := queue.removeAt(0)
        taken += 1
        __notify()
        return value
    }

    // No more values will be sent; receivers get what is left, then null.
    fn close() {
        closed = true
        __notify()
    }

    // Handle each value until the channel is closed and empty.
    fn forEach(action: (T) -> Unit) {
        value := receive()
        while value != null {
            action(value)
            value = receive()
        }
    }

    // Everything that is sent from now on, until the channel is closed.
    fn drain() -> List<T> {
        out := List<T>()
        forEach { out.add(it) }
        return out
    }
}

// ── Result ──────────────────────────────────────────────────────────────────────────────────────
/**
 * Either a success value (`Ok(v)`) or an error (`Err(e)`), for operations that can fail in ordinary ways.
 *
 *     fn parse(text: String) -> Result<Int, String> {
 *         n := text.toIntOrNull() ?: return Err("not a number: $text")
 *         return Ok(n)
 *     }
 *     fn doubled(text: String) -> Result<Int, String> = Ok(parse(text)? * 2)
 *
 * `r?` is the value of `r` if it is an `Ok`; if it is an `Err`, the function returns that error at once
 * (its own result type must be a `Result` with the same error type).  `r?.method()` means `(r?).method()`.
 * Elsewhere take a result apart with `isOk()`, `getOrNull()`, `unwrapOr(x)`, `map`, `andThen`, or a `when`
 * over `r.isOk()`.  The compiler reads the fields `ok`, `value` and `error` in this order for `?`.
 */
type Result<T, E>(ok: Bool, value: T? = null, error: E? = null) {
    fn isOk() = ok
    fn isErr() = !ok

    // The value; stops the program with the error if there is none.
    fn unwrap() -> T {
        if !ok { panic("called unwrap on an Err: $error") }
        return value!!
    }

    fn unwrapOr(fallback: T) -> T = ok ? value!! : fallback

    // The error; stops the program if the result is an Ok.
    fn unwrapErr() -> E {
        if ok { panic("called unwrapErr on an Ok") }
        return error!!
    }

    fn getOrNull() -> T? = value
    fn errorOrNull() -> E? = error

    fn map<R>(transform: (T) -> R) -> Result<R, E> {
        if !ok { return Err(error!!) }
        return Ok(transform(value!!))
    }

    fn mapError<F>(transform: (E) -> F) -> Result<T, F> {
        if ok { return Ok(value!!) }
        return Err(transform(error!!))
    }

    fn andThen<R>(next: (T) -> Result<R, E>) -> Result<R, E> {
        if !ok { return Err(error!!) }
        return next(value!!)
    }

    fn toString() = ok ? "Ok($value)" : "Err($error)"
}

fn Ok<T, E>(value: T) -> Result<T, E> = Result<T, E>(true, value: value)
fn Err<T, E>(error: E) -> Result<T, E> = Result<T, E>(false, error: error)

// Run `action`; a panic inside it becomes an `Err` holding the message.
fn runCatching<T>(action: () -> T) -> Result<T, String> = try { Ok(action()) } catch e { Err(e) }

// ── Assertions, for tests (`aion test`) ─────────────────────────────────────────────────────────
/**
 * Stop the program with `message` unless `condition` holds.  `aion test` counts a program that stops as failed.
 */
fn assert(condition: Bool, message: String = "assertion failed") {
    if !condition { panic(message) }
}

/** Stop the program unless `actual == expected`, saying what each was. */
fn assertEq<T>(actual: T, expected: T, message: String = "") {
    if actual != expected {
        prefix := message.isEmpty() ? "" : "$message: "
        panic("${prefix}expected $expected but got $actual")
    }
}

/** Stop the program unless `actual != unexpected`. */
fn assertNe<T>(actual: T, unexpected: T, message: String = "") {
    if actual == unexpected {
        prefix := message.isEmpty() ? "" : "$message: "
        panic("${prefix}expected something other than $unexpected")
    }
}

/** Stop the program unless `condition` is false. */
fn assertFalse(condition: Bool, message: String = "expected false") {
    if condition { panic(message) }
}

/** Stop the program unless `value` is null. */
fn assertNull<T>(value: T?, message: String = "") {
    if value != null {
        prefix := message.isEmpty() ? "" : "$message: "
        panic("${prefix}expected null but got $value")
    }
}

/** Stop the program if `value` is null. */
fn assertNotNull<T>(value: T?, message: String = "expected a value, got null") {
    if value == null { panic(message) }
}

/** Stop the program unless `actual` is within `tolerance` of `expected`. */
fn assertClose(actual: Float, expected: Float, tolerance: Float = 0.000000001) {
    gap := actual - expected
    if gap < 0.0 { gap = -gap }
    if gap > tolerance { panic("expected $expected (give or take $tolerance) but got $actual") }
}

/** Stop the program unless the list holds `item`. */
fn assertContains<T>(items: List<T>, item: T) {
    if !items.contains(item) { panic("expected $items to contain $item") }
}

/** Stop the program unless `text` has `part` in it (`assertContains` is for lists). */
fn assertContainsText(text: String, part: String) {
    if !text.contains(part) { panic("expected \"$text\" to contain \"$part\"") }
}

/**
 * Run `body`, which must panic, and give the panic's message; stops the program if it finishes normally.
 * `msg := assertFails { 1 / 0 }` leaves `msg` as `division by zero`.
 */
fn assertFails(body: () -> Unit) -> String {
    failure: String? = try { body(); null } catch e { e }
    return failure ?: panic("expected a panic, but nothing went wrong")
}

// ── Support for `defer` and `try` (the compiler calls these; not for direct use) ──
extern fn __defer_push(action: () -> Unit) = "aion_defer_push"
extern fn __defer_mark() -> Int = "aion_defer_mark"
extern fn __defer_run(mark: Int) = "aion_defer_run"
extern fn __try(body: () -> Unit, handler: (String) -> Unit) = "aion_try"
// …and one per kind of result: the compiler passes closures returning that kind
extern fn __try_int(body: () -> Int, handler: (String) -> Int) -> Int = "aion_try_word"
extern fn __try_float(body: () -> Float, handler: (String) -> Float) -> Float = "aion_try_float"
extern fn __try_bool(body: () -> Bool, handler: (String) -> Bool) -> Bool = "aion_try_bool"
extern fn __try_ptr(body: () -> String, handler: (String) -> String) -> String = "aion_try_ptr"

// ── Any and casts ───────────────────────────────────────────────────────────────────────────────
/**
 * `Any` holds a value of any type, when the type is only known while the program runs.
 *
 *     things: List<Any> = [1, "two", 3.0, true, Point(4, 5)]
 *     for t in things {
 *         when t {
 *             is Int -> println("int ${t + 1}")
 *             is String -> println("text ${t.upper()}")
 *             is Point -> println("point ${t.x}")
 *             else -> println("something else: $t")
 *         }
 *     }
 *
 * Any object, and any `Int`, `Float`, `Bool`, `Char`, `String` or `Bytes`, converts to `Any` where
 * an `Any` is expected.  Going back takes a check: `v is Int` tests (and, in the branch, `v` is an `Int`),
 * `v as Int` stops the program when it is something else, and `v as? Int` gives `null` instead.
 * Printing an `Any` prints the value inside it.  An `Any` has no methods of its own and no `==`: compare
 * after checking, e.g. `v is Int && v == 3`.
 */
interface Any {}

// A basic value inside an `Any` lives in one of these boxes (the compiler puts values in and takes them out).
type __IntBox(value: Int) { fn toString() = "$value" }
type __FloatBox(value: Float) { fn toString() = "$value" }
type __BoolBox(value: Bool) { fn toString() = "$value" }
type __CharBox(value: Char) { fn toString() = value.toString() }
type __StringBox(value: String) { fn toString() = value }
type __BytesBox(value: Bytes) { fn toString() = "Bytes(${value.size()})" }

fn __box_Int(v: Int) -> Any = __IntBox(v)
fn __box_Float(v: Float) -> Any = __FloatBox(v)
fn __box_Bool(v: Bool) -> Any = __BoolBox(v)
fn __box_Char(v: Char) -> Any = __CharBox(v)
fn __box_String(v: String) -> Any = __StringBox(v)
fn __box_Bytes(v: Bytes) -> Any = __BytesBox(v)

fn __is_Int(a: Any?) -> Bool = a is __IntBox
fn __is_Float(a: Any?) -> Bool = a is __FloatBox
fn __is_Bool(a: Any?) -> Bool = a is __BoolBox
fn __is_Char(a: Any?) -> Bool = a is __CharBox
fn __is_String(a: Any?) -> Bool = a is __StringBox
fn __is_Bytes(a: Any?) -> Bool = a is __BytesBox

fn __cast_Any_Int(a: Any?) -> Int {
    if a is __IntBox { return a.value }
    panic("cannot cast $a to Int")
}
fn __cast_Any_Float(a: Any?) -> Float {
    if a is __FloatBox { return a.value }
    panic("cannot cast $a to Float")
}
fn __cast_Any_Bool(a: Any?) -> Bool {
    if a is __BoolBox { return a.value }
    panic("cannot cast $a to Bool")
}
fn __cast_Any_Char(a: Any?) -> Char {
    if a is __CharBox { return a.value }
    panic("cannot cast $a to Char")
}
fn __cast_Any_String(a: Any?) -> String {
    if a is __StringBox { return a.value }
    panic("cannot cast $a to String")
}
fn __cast_Any_Bytes(a: Any?) -> Bytes {
    if a is __BytesBox { return a.value }
    panic("cannot cast $a to Bytes")
}

fn __cast_Any_Int_safe(a: Any?) -> Int? = if a is __IntBox { a.value } else { null }
fn __cast_Any_Float_safe(a: Any?) -> Float? = if a is __FloatBox { a.value } else { null }
fn __cast_Any_Bool_safe(a: Any?) -> Bool? = if a is __BoolBox { a.value } else { null }
fn __cast_Any_Char_safe(a: Any?) -> Char? = if a is __CharBox { a.value } else { null }
fn __cast_Any_String_safe(a: Any?) -> String? = if a is __StringBox { a.value } else { null }
fn __cast_Any_Bytes_safe(a: Any?) -> Bytes? = if a is __BytesBox { a.value } else { null }

// `x as T` between basic types.  `Float as Int` drops the fraction; `Char as Int` is the code point.
fn __cast_Int_Float(n: Int) -> Float = n + 0.0
fn __cast_Float_Int(x: Float) -> Int = x.toInt()
fn __cast_Char_Int(c: Char) -> Int = c - '\0'
fn __cast_Int_Char(n: Int) -> Char = '\0' + n
fn __cast_Bool_Int(b: Bool) -> Int = if b { 1 } else { 0 }
fn __cast_Int_Bool(n: Int) -> Bool = n != 0
fn __cast_Int_String(n: Int) -> String = "$n"
fn __cast_Float_String(x: Float) -> String = "$x"
fn __cast_Bool_String(b: Bool) -> String = "$b"
fn __cast_Char_String(c: Char) -> String = c.toString()

fn __cast_String_Int(s: String) -> Int = s.toIntOrNull() ?: panic("cannot cast '$s' to Int")
fn __cast_String_Float(s: String) -> Float = s.toFloatOrNull() ?: panic("cannot cast '$s' to Float")
fn __cast_String_Bool(s: String) -> Bool {
    if s == "true" { return true }
    if s == "false" { return false }
    panic("cannot cast '$s' to Bool")
}
fn __cast_String_Int_safe(s: String) -> Int? = s.toIntOrNull()
fn __cast_String_Float_safe(s: String) -> Float? = s.toFloatOrNull()
fn __cast_String_Bool_safe(s: String) -> Bool? = if s == "true" { true } else if s == "false" { false } else { null }

// ── Function types ──────────────────────────────────────────────────────────────────────────────
/** A test on a value: `Predicate<Int>` is `(Int) -> Bool`.  `filter`, `any`, `takeWhile` and friends take one. */
synonym Predicate<T> = (T) -> Bool
/** A test on two values: `(A, B) -> Bool`. */
synonym BiPredicate<A, B> = (A, B) -> Bool
/** Turns a `T` into an `R`: `(T) -> R`.  What `map` takes. */
synonym Function<T, R> = (T) -> R
/** Turns two values into a third: `(A, B) -> R`. */
synonym BiFunction<A, B, R> = (A, B) -> R
/** Does something with a value and gives nothing back: `(T) -> Unit`.  What `forEach` and `peek` take. */
synonym Consumer<T> = (T) -> Unit
/** Makes a value out of nothing: `() -> T`.  What `generate` takes. */
synonym Supplier<T> = () -> T
/** Turns a `T` into another `T`: `(T) -> T`. */
synonym UnaryOperator<T> = (T) -> T
/** Combines two `T`s into one: `(T, T) -> T`.  What `reduce` takes. */
synonym BinaryOperator<T> = (T, T) -> T
/** Orders two values: negative if the first goes first, zero if they tie, positive if the second does. */
synonym Comparator<T> = (T, T) -> Int

// ── Streams ─────────────────────────────────────────────────────────────────────────────────────
// A one-slot holder, for state that a stream's closures share.
type __Cell<V>(value: V? = null)

// Everything a pull function still produces.
fn __drain<T>(src: () -> T?) -> List<T> {
    out := List<T>()
    x := src()
    while x != null {
        out.add(x)
        x = src()
    }
    return out
}

fn __to_array<T>(items: List<T>) -> Array<T> {
    out := Array<T>(items.size())
    for i in 0..items.size() { out[i] = items[i] }
    return out
}

// The loops behind some stream steps are plain functions: inside a closure, a variable that is assigned
// (`x = src()`) is never smart-cast, so `while x != null { use(x) … }` only works out here.
fn __next_chunk<T>(src: () -> T?, size: Int) -> List<T> {
    chunk := List<T>()
    x := src()
    while x != null {
        chunk.add(x)
        if chunk.size() == size { break }
        x = src()
    }
    return chunk
}

fn __fill<T>(window: List<T>, src: () -> T?, size: Int) {
    x := src()
    while x != null {
        window.add(x)
        if window.size() == size { break }
        x = src()
    }
}

fn __slide<T>(window: List<T>, src: () -> T?, step: Int) -> Bool {
    n := 0
    while n < step {
        x := src()
        if x == null { return false }
        window.removeAt(0)
        window.add(x)
        n += 1
    }
    return true
}

fn __skip_while<T>(src: () -> T?, drop: Predicate<T>) -> T? {
    x := src()
    while x != null && drop(x) { x = src() }
    return x
}

// `chunked` and `windowed` are written out here, so that `Stream<T>` need not name `Stream<List<T>>`
// in its own methods (a type that mentions ever larger versions of itself cannot be built).
fn __chunked<T>(src: () -> T?, size: Int) -> Stream<List<T>> {
    if size <= 0 { panic("chunked needs a positive size") }
    return Stream<List<T>>({
        chunk := __next_chunk(src, size)
        if chunk.isEmpty() { null } else { chunk }
    })
}

fn __windowed<T>(src: () -> T?, size: Int, step: Int) -> Stream<List<T>> {
    if size <= 0 || step <= 0 { panic("windowed needs a positive size and step") }
    window := List<T>()
    started := false
    return Stream<List<T>>({
        full := false
        if !started {
            started = true
            __fill(window, src, size)
            full = window.size() == size
        } else if window.size() == size {
            full = __slide(window, src, step)
        }
        if full { window.copy() } else { null }
    })
}

/** Count, sum, smallest, largest and mean of a stream of numbers (see `Stream.summaryStatistics`). */
data type Stats(count: Int, sum: Float, min: Float, max: Float, average: Float)

/**
 * A lazy sequence of values, as in Java: `list.stream().filter(...).map(...).limit(3).toList()`.
 * Nothing runs until a *terminal* operation (`toList`, `forEach`, `sum`, `count`, `reduce`, `anyMatch`,
 * ...) asks for values, and each value travels through the whole chain before the next one starts, so
 * `limit` and `findFirst` stop early and a stream can be endless (`iterate`, `generate`).
 * A stream is used once: after a terminal operation it is spent.
 *
 *     names := ["ann", "bob", "cy", "dee"]
 *     names.stream()
 *          .filter { it.length() == 3 }          // Predicate<String>
 *          .map { it.upper() }                    // Function<String, String>
 *          .sorted()
 *          .joining(", ")                         // "ANN, BOB, DEE"
 *
 * Make one with `list.stream()`, `set.stream()`, `map.stream()`, `(1..10).stream()`, `streamOf(1, 2, 3)`,
 * `iterate(1) { it * 2 }`, `generate { random() }`, `streamRange(0, 5)` or `emptyStream<Int>()`.
 *
 * Java's `collect(Collectors.x(...))` is a method here: `toList`, `toSet`, `toMap`, `groupBy`,
 * `groupCounting`, `partition`, `joining`, `count`, `sum`, `average`, `summaryStatistics`.  A stream
 * has no `null` elements (`null` marks its end), so a `Stream<Int?>` is not possible.
 */
type Stream<T>(pull: () -> T?) {
    // ── intermediate operations: each gives a new stream ──

    /** The next value, or `null` when the stream is spent. */
    fn next() -> T? = pull()

    /** The values for which `keep` is true.  (`Stream.filter`) */
    fn filter(keep: Predicate<T>) -> Stream<T> {
        src := pull
        return Stream<T>({
            found: T? = null
            done := false
            while !done {
                x := src()
                if x == null {
                    done = true
                } else if keep(x) {
                    found = x
                    done = true
                }
            }
            found
        })
    }

    /** The values for which `drop` is false. */
    fn filterNot(drop: Predicate<T>) -> Stream<T> = filter { !drop(it) }

    /** Each value turned into `f(value)`.  (`Stream.map`) */
    fn map<R>(f: Function<T, R>) -> Stream<R> {
        src := pull
        return Stream<R>({
            x := src()
            if x == null { null } else { f(x) }
        })
    }

    /** Like `map`, with the position of the value as well: `f(index, value)`. */
    fn mapIndexed<R>(f: BiFunction<Int, T, R>) -> Stream<R> {
        src := pull
        position := 0
        return Stream<R>({
            x := src()
            if x == null {
                null
            } else {
                i := position
                position += 1
                f(i, x)
            }
        })
    }

    /** `f(value)` for each value, leaving out the `null`s. */
    fn mapNotNull<R>(f: (T) -> R?) -> Stream<R> {
        src := pull
        return Stream<R>({
            found: R? = null
            done := false
            while !done {
                x := src()
                if x == null {
                    done = true
                } else {
                    y := f(x)
                    if y != null {
                        found = y
                        done = true
                    }
                }
            }
            found
        })
    }

    /** Each value turned into a stream, and those streams joined end to end.  (`Stream.flatMap`) */
    fn flatMap<R>(f: Function<T, Stream<R>>) -> Stream<R> {
        src := pull
        inner := __Cell<Stream<R>>()
        return Stream<R>({
            found: R? = null
            done := false
            while !done {
                current := inner.value
                if current != null {
                    y := current.next()
                    if y != null {
                        found = y
                        done = true
                    } else {
                        inner.value = null
                    }
                } else {
                    x := src()
                    if x == null { done = true } else { inner.value = f(x) }
                }
            }
            found
        })
    }

    /** Like `flatMap`, for a function that gives a list. */
    fn flatMapList<R>(f: Function<T, List<R>>) -> Stream<R> = flatMap { f(it).stream() }

    /** The first occurrence of each value (by `equals` and `hashCode`), in order.  (`Stream.distinct`) */
    fn distinct() -> Stream<T> {
        seen := Set<T>()
        return filter { seen.add(it) }
    }

    /** The first value for each result of `key`. */
    fn distinctBy<K>(key: Function<T, K>) -> Stream<T> {
        seen := Set<K>()
        return filter { seen.add(key(it)) }
    }

    /** Runs `look` on each value as it goes by, e.g. to print it, and passes it on.  (`Stream.peek`) */
    fn peek(look: Consumer<T>) -> Stream<T> {
        src := pull
        return Stream<T>({
            x := src()
            if x != null { look(x) }
            x
        })
    }

    /** At most the first `n` values.  (`Stream.limit`) */
    fn limit(n: Int) -> Stream<T> {
        src := pull
        left := n
        return Stream<T>({
            if left <= 0 {
                null
            } else {
                left -= 1
                src()
            }
        })
    }

    /** Everything after the first `n` values.  (`Stream.skip`) */
    fn skip(n: Int) -> Stream<T> {
        src := pull
        left := n
        return Stream<T>({
            while left > 0 {
                left -= 1
                src()
            }
            src()
        })
    }

    /** The values up to, not including, the first one that fails `keep`.  (`Stream.takeWhile`) */
    fn takeWhile(keep: Predicate<T>) -> Stream<T> {
        src := pull
        over := false
        return Stream<T>({
            found: T? = null
            if !over {
                x := src()
                if x != null && !keep(x) { over = true } else { found = x }
            }
            found
        })
    }

    /** The values from the first one that fails `drop` on.  (`Stream.dropWhile`) */
    fn dropWhile(drop: Predicate<T>) -> Stream<T> {
        src := pull
        dropping := true
        return Stream<T>({
            if dropping {
                dropping = false
                __skip_while(src, drop)
            } else {
                src()
            }
        })
    }

    /** This stream followed by `other`.  (`Stream.concat`) */
    fn concat(other: Stream<T>) -> Stream<T> {
        first := pull
        second := other.pull
        onFirst := true
        return Stream<T>({
            found: T? = null
            if onFirst {
                found = first()
                if found == null {
                    onFirst = false
                    found = second()
                }
            } else {
                found = second()
            }
            found
        })
    }

    /** Pairs of values from this stream and `other`, until the shorter one ends. */
    fn zip<U>(other: Stream<U>) -> Stream<(T, U)> {
        src := pull
        theirs := other.pull
        return Stream<(T, U)>({
            x := src()
            y := theirs()
            if x == null || y == null { null } else { (x, y) }
        })
    }

    /** Pairs of `(position, value)`. */
    fn withIndex() = mapIndexed { i, x -> (i, x) }

    /** Lists of `size` values (the last one may be shorter). */
    fn chunked(size: Int) = __chunked(pull, size)

    /** Sliding windows of `size` values, moving on by `step`. */
    fn windowed(size: Int, step: Int = 1) = __windowed(pull, size, step)

    /** The values in order, smallest first (they need `compareTo`).  Reads the whole stream when it starts. */
    fn sorted() -> Stream<T> = sortedWith { a, b -> a.compareTo(b) }

    /** The values in order, largest first. */
    fn sortedDescending() -> Stream<T> = sortedWith { a, b -> b.compareTo(a) }

    /** The values ordered by `key(value)`. */
    fn sortedBy<K: Comparable<K>>(key: Function<T, K>) -> Stream<T> = sortedWith { a, b -> key(a).compareTo(key(b)) }

    /** The values ordered by `compare`.  (`Stream.sorted(Comparator)`) */
    fn sortedWith(compare: Comparator<T>) -> Stream<T> {
        src := pull
        loaded := List<T>()
        ready := false
        position := 0
        return Stream<T>({
            if !ready {
                ready = true
                loaded.addAll(__drain(src).sortedWith(compare))
            }
            if position < loaded.size() {
                position += 1
                loaded.get(position - 1)
            } else {
                null
            }
        })
    }

    /** The values in the opposite order.  Reads the whole stream when it starts. */
    fn reversed() -> Stream<T> {
        src := pull
        loaded := List<T>()
        ready := false
        position := 0
        return Stream<T>({
            if !ready {
                ready = true
                loaded.addAll(__drain(src).reversed())
            }
            if position < loaded.size() {
                position += 1
                loaded.get(position - 1)
            } else {
                null
            }
        })
    }

    // ── terminal operations: each reads the stream ──

    /** Runs `action` on every value.  (`Stream.forEach`, `forEachOrdered`) */
    fn forEach(action: Consumer<T>) {
        x := pull()
        while x != null {
            action(x)
            x = pull()
        }
    }

    /** Like `forEach`, with the position as well: `action(index, value)`. */
    fn forEachIndexed(action: (Int, T) -> Unit) {
        i := 0
        x := pull()
        while x != null {
            action(i, x)
            i += 1
            x = pull()
        }
    }

    /** All the values, in a list.  (`Stream.toList()`, `Collectors.toList()`) */
    fn toList() -> List<T> = __drain(pull)

    /** All the values, without duplicates.  (`Collectors.toSet()`) */
    fn toSet() = setOf(toList())

    /** A map from `key(value)` to `value(value)`; a repeated key keeps the last.  (`Collectors.toMap`) */
    fn toMap<K, V>(key: Function<T, K>, value: Function<T, V>) -> Map<K, V> {
        out := Map<K, V>()
        forEach { out[key(it)] = value(it) }
        return out
    }

    /** Like `toMap`, combining the values of a repeated key with `merge(old, new)`. */
    fn toMapMerging<K, V>(key: Function<T, K>, value: Function<T, V>, merge: BinaryOperator<V>) -> Map<K, V> {
        out := Map<K, V>()
        forEach {
            k := key(it)
            v := value(it)
            old := out.getOrNull(k)
            out[k] = if old == null { v } else { merge(old, v) }
        }
        return out
    }

    /** Lists of the values that share a `key(value)`.  (`Collectors.groupingBy`) */
    fn groupBy<K>(key: Function<T, K>) -> Map<K, List<T>> {
        out := Map<K, List<T>>()
        forEach {
            k := key(it)
            group := out.getOrNull(k)
            if group == null {
                fresh := List<T>()
                fresh.add(it)
                out[k] = fresh
            } else {
                group.add(it)
            }
        }
        return out
    }

    /** How many values share each `key(value)`.  (`Collectors.groupingBy(f, Collectors.counting())`) */
    fn groupCounting<K>(key: Function<T, K>) -> Map<K, Int> {
        out := Map<K, Int>()
        forEach {
            k := key(it)
            out[k] = out.getOr(k, 0) + 1
        }
        return out
    }

    /** Two lists: the values for which `test` is true, and the rest.  (`Collectors.partitioningBy`) */
    fn partition(test: Predicate<T>) -> (List<T>, List<T>) {
        yes := List<T>()
        no := List<T>()
        forEach { if test(it) { yes.add(it) } else { no.add(it) } }
        return (yes, no)
    }

    /** The values as text, between `prefix` and `suffix`, separated by `separator`.  (`Collectors.joining`) */
    fn joining(separator: String = ", ", prefix: String = "", suffix: String = "") -> String =
        prefix + toList().join(separator) + suffix

    /** Builds a result by hand: `supplier()` makes the container, `accumulate(container, value)` adds to it. */
    fn collect<A>(supplier: Supplier<A>, accumulate: (A, T) -> Unit) -> A {
        container := supplier()
        forEach { accumulate(container, it) }
        return container
    }

    /** How many values there are.  (`Stream.count`) */
    fn count() -> Int {
        n := 0
        forEach { n += 1 }
        return n
    }

    /** The sum of the values (0 for none); they must be numbers.  (`IntStream.sum`) */
    fn sum() -> T {
        total: T = 0
        forEach { total = total + it }
        return total
    }

    /** The mean of the values as a `Float`, or `null` for none.  (`IntStream.average`) */
    fn average() -> Float? {
        n := 0
        total := 0.0
        forEach {
            n += 1
            total += it as Float
        }
        return if n == 0 { null } else { total / (n as Float) }
    }

    /** Count, sum, smallest, largest and mean of the values, which must be numbers. */
    fn summaryStatistics() -> Stats {
        n := 0
        total := 0.0
        low := 0.0
        high := 0.0
        forEach {
            x := it as Float
            if n == 0 || x < low { low = x }
            if n == 0 || x > high { high = x }
            n += 1
            total += x
        }
        return Stats(n, total, low, high, if n == 0 { 0.0 } else { total / (n as Float) })
    }

    /** The smallest value, or `null` for none.  (`Stream.min`) */
    fn min() -> T? = toList().minOrNull()

    /** The largest value, or `null` for none.  (`Stream.max`) */
    fn max() -> T? = toList().maxOrNull()

    /** The value with the smallest `key(value)`, or `null` for none. */
    fn minBy<K: Comparable<K>>(key: Function<T, K>) -> T? = minWith { a, b -> key(a).compareTo(key(b)) }

    /** The value with the largest `key(value)`, or `null` for none. */
    fn maxBy<K: Comparable<K>>(key: Function<T, K>) -> T? = minWith { a, b -> key(b).compareTo(key(a)) }

    /** The value that `compare` puts first, or `null` for none.  The earliest wins a tie.  (`Stream.min(Comparator)`) */
    fn minWith(compare: Comparator<T>) -> T? {
        best: T? = null
        forEach {
            current := best
            if current == null || compare(it, current) < 0 { best = it }
        }
        return best
    }

    /** The value that `compare` puts last, or `null` for none.  (`Stream.max(Comparator)`) */
    fn maxWith(compare: Comparator<T>) -> T? = minWith { a, b -> compare(b, a) }

    /** The values combined with `combine`, or `null` for none.  (`Stream.reduce(BinaryOperator)`) */
    fn reduce(combine: BinaryOperator<T>) -> T? {
        total: T? = null
        forEach {
            current := total
            total = if current == null { it } else { combine(current, it) }
        }
        return total
    }

    /** The values combined with `combine`, starting from `initial`.  (`Stream.reduce(identity, accumulator)`) */
    fn fold<R>(initial: R, combine: (R, T) -> R) -> R {
        total := initial
        forEach { total = combine(total, it) }
        return total
    }

    /** Is `test` true for at least one value?  Stops at the first.  (`Stream.anyMatch`) */
    fn anyMatch(test: Predicate<T>) -> Bool = filter(test).next() != null

    /** Is `test` true for every value?  Stops at the first failure.  (`Stream.allMatch`) */
    fn allMatch(test: Predicate<T>) -> Bool = filterNot(test).next() == null

    /** Is `test` true for no value?  (`Stream.noneMatch`) */
    fn noneMatch(test: Predicate<T>) -> Bool = filter(test).next() == null

    /** The first value, or `null` for none.  (`Stream.findFirst`, `findAny`) */
    fn findFirst() -> T? = pull()

    /** The first value for which `test` is true, or `null`. */
    fn find(test: Predicate<T>) -> T? = filter(test).next()

    /** Same as `forEach`: a stream here always runs in order.  (`Stream.forEachOrdered`) */
    fn forEachOrdered(action: Consumer<T>) = forEach(action)

    /** Same as `findFirst`.  (`Stream.findAny`) */
    fn findAny() -> T? = pull()

    /** The sum of `f(value)`.  (`Collectors.summingInt`) */
    fn sumOf<R>(f: Function<T, R>) -> R = map(f).sum()

    /** The mean of `f(value)`, or `null` for none.  (`Collectors.averagingInt`) */
    fn averageOf<R>(f: Function<T, R>) -> Float? = map(f).average()

    /** Is `value` one of the values?  Stops when it finds it. */
    fn contains(value: T) -> Bool = anyMatch { it == value }

    /** The values in an `Array`.  (`Stream.toArray`) */
    fn toArray() = __to_array(toList())

    /** The last value, or `null` for none. */
    fn last() -> T? {
        found: T? = null
        forEach { found = it }
        return found
    }

    /** The values, so that `for x in stream` works (read all at once: `limit` an endless stream first). */
    fn iter() = toList()

    fn toString() = "Stream"
}

/** A stream of the given values.  (`Stream.of`) */
fn streamOf<T>(vararg items: T) -> Stream<T> = items.stream()

/** A stream with no values.  (`Stream.empty`) */
fn emptyStream<T>() -> Stream<T> = Stream<T>({ null })

/** `seed`, `next(seed)`, `next(next(seed))`, ... without end; cut it with `limit`.  (`Stream.iterate`) */
fn iterate<T>(seed: T, next: UnaryOperator<T>) -> Stream<T> {
    current := seed
    started := false
    return Stream<T>({
        if started { current = next(current) } else { started = true }
        current
    })
}

/** Like `iterate`, but stops before the first value for which `hasNext` is false.  (3-argument `Stream.iterate`) */
fn iterateWhile<T>(seed: T, hasNext: Predicate<T>, next: UnaryOperator<T>) -> Stream<T> =
    iterate(seed, next).takeWhile(hasNext)

/** `supplier()` again and again, without end; cut it with `limit`.  (`Stream.generate`) */
fn generate<T>(supplier: Supplier<T>) -> Stream<T> = Stream<T>({ supplier() })

/** The Ints from `from` up to, not including, `to`.  (`IntStream.range`) */
fn streamRange(from: Int, to: Int) -> Stream<Int> {
    current := from
    return Stream<Int>({
        if current >= to {
            null
        } else {
            current += 1
            current - 1
        }
    })
}

/** The Ints from `from` up to and including `to`.  (`IntStream.rangeClosed`) */
fn streamRangeClosed(from: Int, to: Int) -> Stream<Int> = streamRange(from, to + 1)

/** `value` repeated `times` times.  (`Collections.nCopies`) */
fn streamRepeat<T>(value: T, times: Int) -> Stream<T> = generate { value }.limit(times)

/** A stream of the elements, in order.  (`Collection.stream`) */
fn List<T>.stream() -> Stream<T> {
    position := 0
    return Stream<T>({
        if position < size() {
            position += 1
            get(position - 1)
        } else {
            null
        }
    })
}

/** A stream of the members, in the order they were added. */
fn Set<T>.stream() -> Stream<T> = toList().stream()

/** A stream of the `(key, value)` entries. */
fn Map<K, V>.stream() -> Stream<Entry<K, V>> = entries().stream()

/** A stream of the numbers in the range. */
fn Range.stream() -> Stream<Int> {
    position := 0
    return Stream<Int>({
        if position < size() {
            position += 1
            get(position - 1)
        } else {
            null
        }
    })
}

// ── Stream steps on a List ──────────────────────────────────────────────────────────────────────
// A list answers the common stream questions without `.stream()` first; each is the stream step of the
// same name run over the list (see `Stream`).

/** The elements for which `drop` is false. */
fn List<T>.filterNot(drop: Predicate<T>) -> List<T> = stream().filterNot(drop).toList()
/** `f(index, element)` for each element. */
fn List<T>.mapIndexed<R>(f: BiFunction<Int, T, R>) -> List<R> = stream().mapIndexed(f).toList()
/** `f(element)` for each element, leaving out the `null`s. */
fn List<T>.mapNotNull<R>(f: (T) -> R?) -> List<R> = stream().mapNotNull(f).toList()
/** The lists `f` gives for each element, joined end to end. */
fn List<T>.flatMap<R>(f: Function<T, List<R>>) -> List<R> = stream().flatMapList(f).toList()
/** The first occurrence of each element. */
fn List<T>.distinct() -> List<T> = stream().distinct().toList()
/** The first element for each result of `key`. */
fn List<T>.distinctBy<K>(key: Function<T, K>) -> List<T> = stream().distinctBy(key).toList()
/** The elements before the first one that fails `keep`. */
fn List<T>.takeWhile(keep: Predicate<T>) -> List<T> = stream().takeWhile(keep).toList()
/** The elements from the first one that fails `drop` on. */
fn List<T>.dropWhile(drop: Predicate<T>) -> List<T> = stream().dropWhile(drop).toList()
/** Is `test` false for every element? */
fn List<T>.none(test: Predicate<T>) -> Bool = !any(test)
/** `action(index, element)` for each element. */
fn List<T>.forEachIndexed(action: (Int, T) -> Unit) { stream().forEachIndexed(action) }
/** Lists of `size` elements (the last may be shorter). */
fn List<T>.chunked(size: Int) = stream().chunked(size).toList()
/** Sliding windows of `size` elements. */
fn List<T>.windowed(size: Int, step: Int = 1) = stream().windowed(size, step).toList()
/** `(index, element)` pairs. */
fn List<T>.withIndex() = stream().withIndex().toList()
/** Lists of the elements that share a `key(element)`. */
fn List<T>.groupBy<K>(key: Function<T, K>) -> Map<K, List<T>> = stream().groupBy(key)
/** How many elements share each `key(element)`. */
fn List<T>.groupCounting<K>(key: Function<T, K>) -> Map<K, Int> = stream().groupCounting(key)
/** Two lists: the elements for which `test` is true, and the rest. */
fn List<T>.partition(test: Predicate<T>) -> (List<T>, List<T>) = stream().partition(test)
/** A map from `key(element)` to `value(element)`. */
fn List<T>.toMap<K, V>(key: Function<T, K>, value: Function<T, V>) -> Map<K, V> = stream().toMap(key, value)
/** The elements without duplicates. */
fn List<T>.toSet() = setOf(this)
/** The sum of the elements (0 for none); they must be numbers. */
fn List<T>.sum() -> T = stream().sum()
/** The sum of `f(element)`. */
fn List<T>.sumOf<R>(f: Function<T, R>) -> R = stream().sumOf(f)
/** The mean of the elements as a `Float`, or `null` for none. */
fn List<T>.average() -> Float? = stream().average()
/** The smallest element, or `null` for none. */
fn List<T>.min() -> T? = minOrNull()
/** The largest element, or `null` for none. */
fn List<T>.max() -> T? = maxOrNull()
/** The element with the smallest `key(element)`, or `null` for none. */
fn List<T>.minBy<K: Comparable<K>>(key: Function<T, K>) -> T? = stream().minBy(key)
/** The element with the largest `key(element)`, or `null` for none. */
fn List<T>.maxBy<K: Comparable<K>>(key: Function<T, K>) -> T? = stream().maxBy(key)
/** The elements combined with `combine`, starting from `initial` (`fold` with the arguments the other way round is `reduce`). */
fn List<T>.reduceOrNull(combine: BinaryOperator<T>) -> T? = stream().reduce(combine)

// ── Everyday conveniences ───────────────────────────────────────────────────────────────────────
// The small things a program reaches for all the time: `abs(x)`, `repeat(3) { … }`, `"%05.1f".format(x)`,
// `xs.remove(3)`, `m.getOrPut(k) { … }`, set arithmetic.  Each is documented where it is declared.

/** Stops the program with `message`, in a place that needs a value: `x ?: error("x is missing")`. */
extern fn error(message: String) = "aion_panic"

/** Stops the program with `message` unless `condition` holds (for the caller's arguments). */
fn require(condition: Bool, message: String = "requirement failed") {
    if !condition { panic(message) }
}

/** Stops the program with `message` unless `condition` holds (for the state of the program). */
fn check(condition: Bool, message: String = "check failed") {
    if !condition { panic(message) }
}

/** Runs `action(0)`, `action(1)`, … `action(times - 1)`.  `repeat(3) { print("*") }` prints `***`. */
fn repeat(times: Int, action: Consumer<Int>) {
    for i in 0..times { action(i) }
}

/** The size of a number without its sign: `abs(-3)` is 3, `abs(-2.5)` is 2.5. */
fn abs<T>(x: T) -> T = if x < 0 { -x } else { x }

/** The smaller of two values: `min(2, 5)` is 2. */
fn min<T: Comparable<T>>(a: T, b: T) -> T = if b.compareTo(a) < 0 { b } else { a }

/** The larger of two values: `max(2, 5)` is 5. */
fn max<T: Comparable<T>>(a: T, b: T) -> T = if b.compareTo(a) > 0 { b } else { a }

/** `x`, kept between `low` and `high`: `clamp(15, 0, 10)` is 10. */
fn clamp<T: Comparable<T>>(x: T, low: T, high: T) -> T = if x.compareTo(low) < 0 { low } else if x.compareTo(high) > 0 { high } else { x }

/** A new list of the given values: `listOf(1, 2, 3)` is `[1, 2, 3]`. */
fn listOf<T>(vararg items: T) -> List<T> = items.copy()

/** A list with no values, of the type you name: `emptyList<Int>()`. */
fn emptyList<T>() -> List<T> = List<T>()

/** A map with no entries, of the types you name: `emptyMap<String, Int>()`. */
fn emptyMap<K, V>() -> Map<K, V> = Map<K, V>()

// ── numbers and characters ──

/** Is the number even? */
fn Int.isEven() = this % 2 == 0
/** Is the number odd? */
fn Int.isOdd() = this % 2 != 0
/** The number, but at least `low`: `3.coerceAtLeast(5)` is 5. */
fn Int.coerceAtLeast(low: Int) = if this < low { low } else { this }
/** The number, but at most `high`: `9.coerceAtMost(5)` is 5. */
fn Int.coerceAtMost(high: Int) = if this > high { high } else { this }
/** The number, kept between `low` and `high`: `15.coerceIn(0, 10)` is 10. */
fn Int.coerceIn(low: Int, high: Int) = this.clamp(low, high)
/** The number, but at least `low`. */
fn Float.coerceAtLeast(low: Float) = if this < low { low } else { this }
/** The number, but at most `high`. */
fn Float.coerceAtMost(high: Float) = if this > high { high } else { this }
/** The number, kept between `low` and `high`. */
fn Float.coerceIn(low: Float, high: Float) = this.clamp(low, high)
/** The character repeated `n` times, as text: `'-' * 3` is `"---"`. */
fn Char.times(n: Int) -> String = toString().repeat(n)
/** The text repeated `n` times: `"ab" * 3` is `"ababab"`. */
fn String.times(n: Int) -> String = repeat(n)
/** Is the character a letter or a digit? */
fn Char.isLetterOrDigit() = isLetter() || isDigit()

// ── strings ──

/** Pads on the left to `width` characters with `fill` (a character or text): `"7".padStart(3, '0')` is `"007"`. */
fn String.padStart(width: Int, fill: Any? = null) = padLeft(width, if fill == null { " " } else { "$fill" })
/** Pads on the right to `width` characters with `fill`: `"ab".padEnd(4, '.')` is `"ab.."`. */
fn String.padEnd(width: Int, fill: Any? = null) = padRight(width, if fill == null { " " } else { "$fill" })
/** Is there at least one character? */
fn String.isNotEmpty() = length() > 0
/** Is there a character that is not white space? */
fn String.isNotBlank() = !isBlank()
/** The characters, as a list. */
fn String.toList() = chars()
/** The first character; stops the program for an empty text. */
fn String.first() -> Char = chars().first()
/** The last character; stops the program for an empty text. */
fn String.last() -> Char = chars().last()
/** The text backwards. */
fn String.reversed() -> String {
    out := StringBuilder()
    cs := chars()
    for i in 0..cs.size() { out.appendChar(cs[cs.size() - 1 - i]) }
    return out.toString()
}
/** The first `n` characters. */
fn String.take(n: Int) -> String = chars().take(n).join("")
/** Everything after the first `n` characters. */
fn String.drop(n: Int) -> String = chars().drop(n).join("")
/** The last `n` characters. */
fn String.takeLast(n: Int) -> String {
    cs := chars()
    return cs.drop(cs.size() - n).join("")
}
/** Everything but the last `n` characters. */
fn String.dropLast(n: Int) -> String {
    cs := chars()
    return cs.take(cs.size() - n).join("")
}
/** The characters for which `keep` is true. */
fn String.filter(keep: Predicate<Char>) -> String = chars().filter(keep).join("")
/** How many characters satisfy `test`. */
fn String.count(test: Predicate<Char>) -> Int = chars().count(test)
/** Is `test` true for at least one character? */
fn String.any(test: Predicate<Char>) -> Bool = chars().any(test)
/** Is `test` true for every character? */
fn String.all(test: Predicate<Char>) -> Bool = chars().all(test)
/** The text without `prefix`, if it starts with it. */
fn String.removePrefix(prefix: String) -> String = if startsWith(prefix) { substring(prefix.length(), length()) } else { this }
/** The text without `suffix`, if it ends with it. */
fn String.removeSuffix(suffix: String) -> String = if endsWith(suffix) { substring(0, length() - suffix.length()) } else { this }
/** The text with its first letter in upper case. */
fn String.capitalize() -> String {
    cs := chars()
    if cs.isEmpty() { return this }
    return cs[0].upper().toString() + cs.drop(1).join("")
}
/** The words of the text, split at any run of white space: `" a  b\tc ".words()` is `[a, b, c]`. */
fn String.words() -> List<String> {
    return replace("\t", " ").replace("\n", " ").replace("\r", " ").split(" ").filter { it.isNotEmpty() }
}
/** The text with the indentation that all its lines share taken off, and a blank first and last line dropped. */
fn String.trimIndent() -> String {
    rows := split("\n")
    if rows.isNotEmpty() && rows.first().isBlank() { rows = rows.drop(1) }
    if rows.isNotEmpty() && rows.last().isBlank() { rows = rows.take(rows.size() - 1) }
    indent := -1
    for row in rows {
        if row.isBlank() { continue }
        width := row.length() - row.trimStart().length()
        if indent < 0 || width < indent { indent = width }
    }
    if indent <= 0 { return rows.join("\n") }
    return rows.map { if it.length() >= indent { it.substring(indent, it.length()) } else { "" } }.join("\n")
}
/** The text as an `Int`; stops the program if it is not one (see `toIntOrNull`). */
fn String.toInt() -> Int = toIntOrNull() ?: error("cannot convert '$this' to Int")
/** The text as a `Float`; stops the program if it is not one (see `toFloatOrNull`). */
fn String.toFloat() -> Float = toFloatOrNull() ?: error("cannot convert '$this' to Float")
/** `true` for "true", `false` for "false"; stops the program for anything else. */
fn String.toBool() -> Bool {
    if this == "true" { return true }
    if this == "false" { return false }
    panic("cannot convert '$this' to Bool")
}

// `"%5.2f".format(x)`: a `%` starts a field, `%%` is a percent sign.  After the `%` come flags (`-` left,
// `0` zeros, `+` always a sign), a width, a `.precision`, and the kind: `d` integer, `f` float, `s` text,
// `c` character, `x` hex, `b` binary, `o` octal.
fn __format_field(kind: Char, arg: Any, precision: Int, plus: Bool) -> String {
    text := ""
    negative := false
    if kind == 'd' || kind == 'x' || kind == 'b' || kind == 'o' {
        n := if arg is Int { arg } else if arg is Char { arg.code() } else { error("%$kind needs an integer, not $arg") }
        negative = n < 0
        magnitude := abs(n)
        text = when kind {
            'x' -> magnitude.toRadix(16)
            'b' -> magnitude.toRadix(2)
            'o' -> magnitude.toRadix(8)
            else -> magnitude.toString()
        }
    } else if kind == 'f' {
        x := if arg is Float { arg } else if arg is Int { arg.toFloat() } else { error("%f needs a number, not $arg") }
        negative = x < 0.0
        text = abs(x).format(if precision < 0 { 6 } else { precision })
    } else if kind == 's' {
        text = "$arg"
        if precision >= 0 { text = text.take(precision) }
        return text
    } else if kind == 'c' {
        return if arg is Char { arg.toString() } else if arg is Int { arg.toChar().toString() } else { "$arg" }
    } else {
        error("unknown format %$kind")
    }
    if negative { return "-" + text }
    return if plus { "+" + text } else { text }
}

/** Fills the `%` fields of the text with `args`: `"%d items cost %.2f".format(3, 4.5)` is `"3 items cost 4.50"`. */
fn String.format(vararg args: Any) -> String {
    out := StringBuilder()
    cs := chars()
    n := cs.size()
    i := 0
    next := 0
    while i < n {
        c := cs[i]
        i += 1
        if c != '%' {
            out.appendChar(c)
            continue
        }
        if i >= n { error("format: the text ends in a lone %") }
        if cs[i] == '%' {
            out.appendChar('%')
            i += 1
            continue
        }
        left := false
        zeros := false
        plus := false
        while i < n && (cs[i] == '-' || cs[i] == '0' || cs[i] == '+') {
            if cs[i] == '-' { left = true } else if cs[i] == '0' { zeros = true } else { plus = true }
            i += 1
        }
        width := 0
        while i < n && cs[i].isDigit() {
            width = width * 10 + cs[i].digitValue()!!
            i += 1
        }
        precision := -1
        if i < n && cs[i] == '.' {
            i += 1
            precision = 0
            while i < n && cs[i].isDigit() {
                precision = precision * 10 + cs[i].digitValue()!!
                i += 1
            }
        }
        if i >= n { error("format: the text ends inside a field") }
        kind := cs[i]
        i += 1
        if next >= args.size() { error("format: too few arguments for '$this'") }
        field := __format_field(kind, args[next], precision, plus)
        next += 1
        if field.length() < width {
            if left {
                field = field.padRight(width)
            } else if zeros && kind != 's' && kind != 'c' {
                sign := if field.startsWith("-") || field.startsWith("+") { field.take(1) } else { "" }
                field = sign + field.drop(sign.length()).padLeft(width - sign.length(), "0")
            } else {
                field = field.padLeft(width)
            }
        }
        out.append(field)
    }
    return out.toString()
}

// ── lists ──

/** Sorts the list itself, smallest first (`sorted()` gives a new list). */
fn List<T>.sort() {
    s := sorted()
    for i in 0..size() { set(i, s[i]) }
}
/** Sorts the list itself, largest first. */
fn List<T>.sortDescending() {
    s := sortedDescending()
    for i in 0..size() { set(i, s[i]) }
}
/** Sorts the list itself by `key(element)`. */
fn List<T>.sortBy<K: Comparable<K>>(key: Function<T, K>) {
    s := sortedBy(key)
    for i in 0..size() { set(i, s[i]) }
}
/** Sorts the list itself by `compare`. */
fn List<T>.sortWith(compare: Comparator<T>) {
    s := sortedWith(compare)
    for i in 0..size() { set(i, s[i]) }
}
/** Turns the list itself around. */
fn List<T>.reverse() {
    for i in 0..size() / 2 {
        other := size() - 1 - i
        held := get(i)
        set(i, get(other))
        set(other, held)
    }
}
/** Swaps two elements. */
fn List<T>.swap(a: Int, b: Int) {
    held := get(a)
    set(a, get(b))
    set(b, held)
}
/** Takes out the first element equal to `value`; false if there was none. */
fn List<T>.remove(value: T) -> Bool {
    at := indexOf(value)
    if at < 0 { return false }
    removeAt(at)
    return true
}
/** Puts `value` in at `index`, moving the elements from there on up by one. */
fn List<T>.insert(index: Int, value: T) {
    if index < 0 || index > size() { panic("insert position $index is outside 0..${size()}") }
    add(value)
    i := size() - 1
    while i > index {
        set(i, get(i - 1))
        i -= 1
    }
    set(index, value)
}
/** Takes out every element for which `test` is true. */
fn List<T>.removeIf(test: Predicate<T>) {
    kept := filterNot(test)
    clear()
    addAll(kept)
}
/** Takes out every element that is in `other`. */
fn List<T>.removeAll(other: List<T>) {
    kept := filterNot { other.contains(it) }
    clear()
    addAll(kept)
}
/** Is there at least one element? */
fn List<T>.isNotEmpty() = size() > 0
/** The positions of the elements: `0..size()`. */
fn List<T>.indices() = Range(0, size())
/** The position of the last element (-1 for an empty list). */
fn List<T>.lastIndex() = size() - 1
/** The position of the first element for which `test` is true, or -1. */
fn List<T>.indexOfFirst(test: Predicate<T>) -> Int {
    for i in 0..size() {
        if test(get(i)) { return i }
    }
    return -1
}
/** The position of the last element for which `test` is true, or -1. */
fn List<T>.indexOfLast(test: Predicate<T>) -> Int {
    i := size() - 1
    while i >= 0 {
        if test(get(i)) { return i }
        i -= 1
    }
    return -1
}
/** The element at `index`, or `fallback()` when there is none. */
fn List<T>.getOrElse(index: Int, fallback: Supplier<T>) -> T = getOrNull(index) ?: fallback()
/** The last `n` elements. */
fn List<T>.takeLast(n: Int) -> List<T> = drop(size() - n)
/** Everything but the last `n` elements. */
fn List<T>.dropLast(n: Int) -> List<T> = take(size() - n)
/** The elements joined end to end: `[[1], [2, 3]].flatten()` is `[1, 2, 3]`. */
fn List<T>.flatten() = flatMap { it }
/** A list of the first parts and a list of the second parts of a list of pairs. */
fn List<T>.unzip() = (map { it.first }, map { it.second })
/** The elements that are not `null`. */
fn List<T>.filterNotNull() = mapNotNull { it }
/** The elements as text, between `prefix` and `suffix`, separated by `separator`. */
fn List<T>.joinToString(separator: String = ", ", prefix: String = "", suffix: String = "") -> String =
    prefix + join(separator) + suffix
/** The largest `f(element)`, or `null` for an empty list. */
fn List<T>.maxOf<R: Comparable<R>>(f: Function<T, R>) = stream().map(f).max()
/** The smallest `f(element)`, or `null` for an empty list. */
fn List<T>.minOf<R: Comparable<R>>(f: Function<T, R>) = stream().map(f).min()
/** A map from `key(element)` to the element; a repeated key keeps the last. */
fn List<T>.associateBy<K>(key: Function<T, K>) -> Map<K, T> = stream().toMap(key, { it })
/** Do both lists hold equal elements in the same order? */
fn List<T>.contentEquals(other: List<T>) -> Bool {
    if size() != other.size() { return false }
    for i in 0..size() {
        if get(i) != other.get(i) { return false }
    }
    return true
}
/** Sorted largest `key(element)` first. */
fn List<T>.sortedByDescending<K: Comparable<K>>(key: Function<T, K>) -> List<T> = sortedWith { a, b -> key(b).compareTo(key(a)) }

// ── maps ──

/** The value for `key`; when there is none, stores and returns `make()`. */
fn Map<K, V>.getOrPut(key: K, make: Supplier<V>) -> V {
    found := getOrNull(key)
    if found != null { return found }
    made := make()
    set(key, made)
    return made
}
/** Stores `value` under `key`; when `key` already has a value, stores `combine(old, value)` instead. */
fn Map<K, V>.merge(key: K, value: V, combine: BinaryOperator<V>) {
    old := getOrNull(key)
    set(key, if old == null { value } else { combine(old, value) })
}
/** Adds every entry of `other`. */
fn Map<K, V>.putAll(other: Map<K, V>) {
    other.forEach { k, v -> set(k, v) }
}
/** A new map with the same keys and `f(value)` as values. */
fn Map<K, V>.mapValues<R>(f: Function<V, R>) -> Map<K, R> {
    out := Map<K, R>()
    forEach { k, v -> out.set(k, f(v)) }
    return out
}
/** A new map with the entries for which `keep(key, value)` is true. */
fn Map<K, V>.filter(keep: BiPredicate<K, V>) -> Map<K, V> {
    out := Map<K, V>()
    forEach { k, v -> if keep(k, v) { out.set(k, v) } }
    return out
}
/** Is there at least one entry? */
fn Map<K, V>.isNotEmpty() = size() > 0
/** Do any entries satisfy `test(key, value)`? */
fn Map<K, V>.any(test: BiPredicate<K, V>) -> Bool = entries().any { test(it.key, it.value) }
/** Do all entries satisfy `test(key, value)`? */
fn Map<K, V>.all(test: BiPredicate<K, V>) -> Bool = entries().all { test(it.key, it.value) }
/** How many entries satisfy `test(key, value)`. */
fn Map<K, V>.count(test: BiPredicate<K, V>) -> Int = entries().count { test(it.key, it.value) }

// ── sets ──

/** Adds every element of `items`. */
fn Set<T>.addAll(items: List<T>) {
    for item in items { add(item) }
}
/** Takes out every element of `items`. */
fn Set<T>.removeAll(items: List<T>) {
    for item in items { remove(item) }
}
/** The elements that are in either set. */
fn Set<T>.union(other: Set<T>) -> Set<T> {
    out := Set<T>()
    out.addAll(toList())
    out.addAll(other.toList())
    return out
}
/** The elements that are in both sets. */
fn Set<T>.intersect(other: Set<T>) -> Set<T> {
    out := Set<T>()
    for item in toList() {
        if other.contains(item) { out.add(item) }
    }
    return out
}
/** The elements of this set that are not in `other`. */
fn Set<T>.subtract(other: Set<T>) -> Set<T> {
    out := Set<T>()
    for item in toList() {
        if !other.contains(item) { out.add(item) }
    }
    return out
}
/** Are all the elements of this set in `other`? */
fn Set<T>.isSubsetOf(other: Set<T>) -> Bool = toList().all { other.contains(it) }
/** The elements for which `keep` is true. */
fn Set<T>.filter(keep: Predicate<T>) -> Set<T> {
    out := Set<T>()
    for item in toList() {
        if keep(item) { out.add(item) }
    }
    return out
}
/** Is there at least one element? */
fn Set<T>.isNotEmpty() = size() > 0
