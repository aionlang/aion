// The prelude: names available in every Aion program without an import.
//
// Also built in, but not expressible as ordinary functions because they
// accept any printable type (Int, Float, Bool or String):
//
//   print(value)     write the value, no newline
//   println(value)   write the value and a newline
//   println()        write just a newline

// Stop the program with `[aion] panic: <message>` on stderr and exit code 1.
extern fn panic(message: String) = "aion_panic"

// Like print and println, but to standard error (diagnostics, usage messages).
extern fn eprint(text: String) = "aion_eprint"
fn eprintln(text: String = "") {
    eprint(text + "\n")
}

// Methods on the built-in types.  "héllo".length() counts bytes.
extern fn String.length() -> Int = "aion_strings_length"
extern fn String.contains(needle: String) -> Bool = "aion_strings_contains"
extern fn String.startsWith(prefix: String) -> Bool = "aion_strings_starts_with"
extern fn String.upper() -> String = "aion_strings_upper"
extern fn String.lower() -> String = "aion_strings_lower"
// Bytes [start, end); stops the program if the range is invalid.
extern fn String.substring(start: Int, end: Int) -> String = "aion_strings_substring"
// Byte offset of the first `needle` at or after byte `from`, or -1.
extern fn __index_from(s: String, needle: String, from: Int) -> Int = "aion_strings_index_from"
fn String.indexOf(needle: String, from: Int = 0) = __index_from(this, needle, from)
extern fn String.trim() -> String = "aion_strings_trim"
extern fn String.replace(from: String, to: String) -> String = "aion_strings_replace"
// The number the text spells, or `fallback` if it is not a whole number.
extern fn String.toIntOr(fallback: Int) -> Int = "aion_strings_to_int_or"
// Is the whole text a whole number?
extern fn String.isInt() -> Bool = "aion_strings_is_int"
fn String.toIntOrNull() -> Int? = if isInt() { toIntOr(0) } else { null }

// The number the text spells, or `fallback` if it is not a decimal number such as "3.5" or "1e-3".
extern fn String.toFloatOr(fallback: Float) -> Float = "aion_strings_to_float_or"
extern fn String.isFloat() -> Bool = "aion_strings_is_float"
fn String.toFloatOrNull() -> Float? = if isFloat() { toFloatOr(0.0) } else { null }
// The number the text spells in a base from 2 to 36 ("ff".parseInt(16) is 255), or null.
fn String.parseInt(radix: Int) -> Int? {
    if radix < 2 || radix > 36 || length() == 0 {
        return null
    }
    negative := startsWith("-")
    at := if negative || startsWith("+") { 1 } else { 0 }
    if at == length() {
        return null
    }
    value := 0
    while at < length() {
        c := lower().charAt(at)
        digit := if c >= '0' && c <= '9' { c - '0' } else if c >= 'a' && c <= 'z' { c - 'a' + 10 } else { 99 }
        if digit >= radix {
            return null
        }
        value = value * radix + digit
        at += 1
    }
    return if negative { -value } else { value }
}

extern fn String.endsWith(suffix: String) -> Bool = "aion_strings_ends_with"
// Byte offset of the last `needle`, or -1.
extern fn String.lastIndexOf(needle: String) -> Int = "aion_strings_last_index_of"
extern fn String.trimStart() -> String = "aion_strings_trim_start"
extern fn String.trimEnd() -> String = "aion_strings_trim_end"
// "ab".repeat(3) is "ababab".
extern fn String.repeat(times: Int) -> String = "aion_strings_repeat"
// How many characters (not bytes) the text has.
extern fn String.charCount() -> Int = "aion_strings_char_count"
extern fn __pad(text: String, width: Int, fill: String, left: Bool) -> String = "aion_strings_pad"
// Fill up to `width` characters: "7".padLeft(3, "0") is "007", "ab".padRight(4) is "ab  ".
fn String.padLeft(width: Int, fill: String = " ") = __pad(this, width, fill, true)
fn String.padRight(width: Int, fill: String = " ") = __pad(this, width, fill, false)
fn String.isEmpty() = length() == 0
fn String.isBlank() = trim().length() == 0

// The character that starts at byte `index`.  s[i] is the same.
extern fn String.charAt(index: Int) -> Char = "aion_str_char_at"
fn String.get(index: Int) = charAt(index)

// The characters of the text; `for c in text` loops over them.
fn String.chars() -> List<Char> {
    out := List<Char>()
    at := 0
    end := length()
    while at < end {
        c := charAt(at)
        out.add(c)
        at += c.byteLength()
    }
    return out
}
fn String.iter() = chars()

// s[from..to] is the text between two byte offsets; size() is the length in bytes.
fn String.size() = length()
fn String.slice(from: Int, to: Int) = substring(from, to)

fn String.split(separator: String) -> List<String> {
    parts := List<String>()
    if separator.length() == 0 {
        parts.add(this)
        return parts
    }
    rest := this
    at := rest.indexOf(separator)
    while at >= 0 {
        parts.add(rest.substring(0, at))
        rest = rest.substring(at + separator.length(), rest.length())
        at = rest.indexOf(separator)
    }
    parts.add(rest)
    return parts
}

// ── Numbers ─────────────────────────────────────────────────────

// Int and Float convert only where you say so: n.toFloat(), x.toInt().
fn Int.toFloat() -> Float = this + 0.0
fn Int.toString() -> String = "$this"
fn Float.toString() -> String = "$this"
fn Bool.toString() -> String = "$this"
// Drops the fraction (towards zero); too-large values stop at the limits of Int, NaN stops the program.
extern fn Float.toInt() -> Int = "aion_float_to_int"
// Nearest whole number (halves go away from zero), and the next whole number down / up.
extern fn Float.round() -> Int = "aion_float_round"
extern fn Float.floor() -> Int = "aion_float_floor"
extern fn Float.ceil() -> Int = "aion_float_ceil"
extern fn Float.isNaN() -> Bool = "aion_float_is_nan"
extern fn Float.isInfinite() -> Bool = "aion_float_is_inf"
// 3.14159.format(2) is "3.14", 2.34567.roundTo(2) is 2.35 (decimal ties round to even, like printf).
extern fn Float.format(decimals: Int) -> String = "aion_float_format"
extern fn Float.roundTo(decimals: Int) -> Float = "aion_float_round_to"

fn Int.abs() = if this < 0 { -this } else { this }
fn Float.abs() = if this < 0.0 { -this } else { this }
fn Int.sign() = if this < 0 { -1 } else if this > 0 { 1 } else { 0 }
fn Float.sign() = if this < 0.0 { -1 } else if this > 0.0 { 1 } else { 0 }
fn Int.min(other: Int) = if other < this { other } else { this }
fn Int.max(other: Int) = if other > this { other } else { this }
fn Float.min(other: Float) = if other < this { other } else { this }
fn Float.max(other: Float) = if other > this { other } else { this }
// The number, or `low` / `high` if it lies outside them.
fn Int.clamp(low: Int, high: Int) = if this < low { low } else if this > high { high } else { this }
fn Float.clamp(low: Float, high: Float) = if this < low { low } else if this > high { high } else { this }

// n.pow(k) for k >= 0, wrapping on overflow like all Int arithmetic.
fn Int.pow(exponent: Int) -> Int {
    if exponent < 0 {
        panic("pow needs a non-negative exponent")
    }
    result := 1
    base := this
    e := exponent
    while e > 0 {
        if e % 2 == 1 {
            result *= base
        }
        base *= base
        e /= 2
    }
    return result
}

// The largest number that divides both (always non-negative).
fn Int.gcd(other: Int) -> Int {
    a := abs()
    b := other.abs()
    while b != 0 {
        t := a % b
        a = b
        b = t
    }
    return a
}

// The digits in another base, 2 to 36: 255.toRadix(16) is "ff".
extern fn Int.toRadix(radix: Int) -> String = "aion_int_to_radix"
fn Int.toHex() = toRadix(16)
fn Int.toBinary() = toRadix(2)

// The lines of the text, without their line breaks (\n or \r\n); a final line break adds no empty line.
fn String.lines() -> List<String> {
    if length() == 0 {
        return List<String>()
    }
    parts := replace("\r\n", "\n").split("\n")
    if parts[parts.size() - 1].length() == 0 {
        parts.pop()
    }
    return parts
}

// ── Characters ──────────────────────────────────────────────────
//
// A Char is a Unicode code point: 'a', '\n', '\u{1F600}'.  c + 1 and c - 1 are
// Chars, c - 'a' is an Int.  Letter classification and case are exact for ASCII,
// Latin-1, Greek and Cyrillic and a rule of thumb elsewhere.

extern fn Char.isDigit() -> Bool = "aion_char_is_digit"
extern fn Char.isLetter() -> Bool = "aion_char_is_letter"
extern fn Char.isUpper() -> Bool = "aion_char_is_upper"
extern fn Char.isLower() -> Bool = "aion_char_is_lower"
extern fn Char.isWhitespace() -> Bool = "aion_char_is_space"
extern fn Char.upper() -> Char = "aion_char_upper"
extern fn Char.lower() -> Char = "aion_char_lower"
// How many bytes the character takes in a String (UTF-8).
extern fn Char.byteLength() -> Int = "aion_char_utf8_len"
extern fn Char.toString() -> String = "aion_char_to_str"

fn Char.code() = this - '\0'
fn Int.toChar() = '\0' + this
// 0..9 for a digit, else null.
fn Char.digitValue() -> Int? = if isDigit() { this - '0' } else { null }

// ── Bytes ───────────────────────────────────────────────────────

// Raw bytes, as read from a file or a socket.  `Bytes(8)` is eight zero bytes,
// `Bytes(8, 255)` eight 0xFF; b[i] is a number from 0 to 255 and b.size() the length.
// Two Bytes are == when they hold the same bytes, and they work as Map keys.
extern fn __bytes_make(size: Int, fill: Int) -> Bytes = "aion_bytes_make"
fn Bytes(size: Int, fill: Int = 0) = __bytes_make(size, fill)

extern fn Bytes.size() -> Int = "aion_bytes_size"
extern fn Bytes.get(index: Int) -> Int = "aion_bytes_get"
extern fn Bytes.set(index: Int, value: Int) = "aion_bytes_set"
// b[from..to] is a copy of those bytes.
extern fn Bytes.slice(from: Int, to: Int) -> Bytes = "aion_bytes_slice"
extern fn Bytes.concat(other: Bytes) -> Bytes = "aion_bytes_concat"
extern fn __bytes_index_of(b: Bytes, value: Int, from: Int) -> Int = "aion_bytes_index_of"
// The position of the first byte equal to `value` at or after `from`, or -1.
fn Bytes.indexOf(value: Int, from: Int = 0) = __bytes_index_of(this, value, from)
fn Bytes.contains(value: Int) = indexOf(value) >= 0

// Lower-case hex, two digits per byte; and back (null if the text is not hex).
extern fn Bytes.toHex() -> String = "aion_bytes_to_hex"
extern fn String.fromHex() -> Bytes? = "aion_bytes_from_hex"
// The UTF-8 text in the bytes (up to the first zero byte); and the bytes of a text.
extern fn Bytes.toText() -> String = "aion_bytes_to_str"
extern fn String.toBytes() -> Bytes = "aion_str_to_bytes"

fn Bytes.toList() -> List<Int> {
    out := List<Int>()
    for i in 0..size() {
        out.add(get(i))
    }
    return out
}
fn Bytes.iter() = toList()

// The bytes with the given values (each 0 to 255).
fn bytesOf(values: List<Int>) -> Bytes {
    out := Bytes(values.size())
    for i in 0..values.size() {
        out[i] = values[i]
    }
    return out
}

// bytes[at..at+count] = src[from..from+count]; the ranges must lie inside both.
extern fn Bytes.copyFrom(at: Int, src: Bytes, from: Int, count: Int) = "aion_bytes_copy"
// Write the UTF-8 bytes of the text into the Bytes, starting at `at`.
extern fn Bytes.putText(at: Int, text: String) = "aion_bytes_put"
extern fn __bytes_text(b: Bytes, from: Int, to: Int) -> String = "aion_bytes_text"

// Position of the first occurrence of `needle` at or after `from`, or -1.
extern fn __bytes_find(b: Bytes, needle: Bytes, from: Int) -> Int = "aion_bytes_find"
fn Bytes.find(needle: Bytes, from: Int = 0) = __bytes_find(this, needle, from)
fn Bytes.startsWith(prefix: Bytes) = prefix.size() <= size() && slice(0, prefix.size()) == prefix

extern fn __bytes_equals(a: Bytes, b: Bytes) -> Bool = "aion_bytes_equals"
extern fn __bytes_hash(b: Bytes) -> Int = "aion_bytes_hash"
fn __bytes_str(b: Bytes) -> String = "Bytes(${b.toHex()})"

// ── StringBuilder ───────────────────────────────────────────────

// Builds text piece by piece, without copying everything built so far for each piece
// (which `text += piece` in a loop does).
//
//   sb := StringBuilder()
//   for i in 0..1000 { sb.append("line ").append("$i").appendLine() }
//   println(sb.length(), sb.toString().lines().size())
type StringBuilder {
    data: Bytes = Bytes(32)
    used: Int

    // How many bytes have been added.
    fn length() = used
    fn isEmpty() = used == 0

    fn reserve(extra: Int) {
        need := used + extra
        if need > data.size() {
            capacity := data.size() * 2
            if capacity < need {
                capacity = need
            }
            bigger := Bytes(capacity)
            bigger.copyFrom(0, data, 0, used)
            data = bigger
        }
    }

    fn append(text: String) -> StringBuilder {
        reserve(text.length())
        data.putText(used, text)
        used += text.length()
        return this
    }
    fn appendChar(c: Char) -> StringBuilder = append(c.toString())
    fn appendLine(text: String = "") -> StringBuilder {
        append(text)
        return append("\n")
    }

    // Forget everything; or keep only the first `length` bytes.
    fn clear() { used = 0 }
    fn truncate(length: Int) {
        if length < 0 || length > used {
            panic("truncate(${length}) is out of range for length $used")
        }
        used = length
    }

    fn toString() = __bytes_text(data, 0, used)
}

// ── BytesBuilder ────────────────────────────────────────────────

// Collects bytes piece by piece, like StringBuilder does for text.
type BytesBuilder {
    data: Bytes = Bytes(64)
    used: Int

    fn size() = used
    fn isEmpty() = used == 0

    fn reserve(extra: Int) {
        need := used + extra
        if need > data.size() {
            capacity := data.size() * 2
            if capacity < need {
                capacity = need
            }
            bigger := Bytes(capacity)
            bigger.copyFrom(0, data, 0, used)
            data = bigger
        }
    }

    fn add(bytes: Bytes) -> BytesBuilder {
        reserve(bytes.size())
        data.copyFrom(used, bytes, 0, bytes.size())
        used += bytes.size()
        return this
    }
    fn addText(text: String) -> BytesBuilder {
        reserve(text.length())
        data.putText(used, text)
        used += text.length()
        return this
    }
    fn addByte(value: Int) -> BytesBuilder {
        reserve(1)
        data[used] = value
        used += 1
        return this
    }

    fn clear() { used = 0 }
    // Everything collected so far, as a Bytes of its own.
    fn toBytes() = data.slice(0, used)
    // Position of the first `needle` at or after `from` among the bytes collected, or -1.
    fn find(needle: Bytes, from: Int = 0) -> Int {
        at := data.find(needle, from)
        return if at >= 0 && at + needle.size() <= used { at } else { -1 }
    }
    // Remove and return the first `count` bytes.
    fn take(count: Int) -> Bytes {
        if count < 0 || count > used {
            panic("take(${count}) is out of range for size $used")
        }
        out := data.slice(0, count)
        dropFirst(count)
        return out
    }
    // The first `count` bytes are gone (they were used up); the rest stays.
    fn dropFirst(count: Int) {
        if count < 0 || count > used {
            panic("dropFirst(${count}) is out of range for size $used")
        }
        data.copyFrom(0, data, count, used - count)
        used -= count
    }
    fn toString() = "BytesBuilder($used bytes)"
}

// ── Ordering ────────────────────────────────────────────────────

// Things that can be put in order: a.compareTo(b) is negative, zero or positive.
// Any type with a matching compareTo qualifies, e.g. `fn compareTo(other: Version) = …`.
interface Comparable<T> { fn compareTo(other: T) -> Int }

fn Int.compareTo(other: Int) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn Float.compareTo(other: Float) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn String.compareTo(other: String) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn Char.compareTo(other: Char) = if this < other { -1 } else if this > other { 1 } else { 0 }
fn Bool.compareTo(other: Bool) = if this == other { 0 } else if this { 1 } else { -1 }

// ── Collections ─────────────────────────────────────────────────
//
// `Array<T>` is built into the compiler: a fixed-size block of slots with
// size(), get(i), set(i, v) and clear(i), also written a[i] and a[i] = v.
// Everything below is ordinary Aion built on top of it.
//
// Conventions the compiler relies on (so your own types can join in):
//   x[i]        calls  x.get(i)         x[i] = v   calls  x.set(i, v)
//   a in x      calls  x.contains(a)
//   for v in x  uses   x.size() and x.get(i), or loops over x.iter() if there is one
//   [a, b]      is a List,  {k: v} is a Map

// A growable list.
type List<T> {
    items: Array<T> = Array<T>(8)
    count: Int

    fn size() = count
    fn isEmpty() = count == 0

    fn get(index: Int) -> T {
        checkIndex(index)
        return items[index]
    }
    fn set(index: Int, value: T) {
        checkIndex(index)
        items[index] = value
    }
    fn checkIndex(index: Int) {
        if index < 0 || index >= count {
            panic("index $index is out of bounds for size $count")
        }
    }

    fn add(value: T) {
        if count == items.size() {
            bigger := Array<T>(count * 2)
            for i in 0..count { bigger[i] = items[i] }
            items = bigger
        }
        items[count] = value
        count += 1
    }
    fn addAll(other: List<T>) {
        for x in other { add(x) }
    }
    // `a + b` is a new list holding the elements of both.
    fn plus(other: List<T>) -> List<T> {
        out := copy()
        out.addAll(other)
        return out
    }
    fn removeAt(index: Int) -> T {
        checkIndex(index)
        removed := items[index]
        for i in index..count - 1 { items[i] = items[i + 1] }
        count -= 1
        items.clear(count)
        return removed
    }
    fn pop() -> T = removeAt(count - 1)
    fn clear() {
        for i in 0..count { items.clear(i) }
        count = 0
    }

    fn first() -> T = get(0)
    fn last() -> T = get(count - 1)
    fn getOrNull(index: Int) -> T? {
        if index < 0 || index >= count { return null }
        return items[index]
    }
    fn firstOrNull() -> T? = getOrNull(0)
    fn lastOrNull() -> T? = getOrNull(count - 1)
    // The first element that passes `test`, or null.
    fn find(test: (T) -> Bool) -> T? {
        for i in 0..count {
            if test(items[i]) { return items[i] }
        }
        return null
    }

    fn contains(value: T) = indexOf(value) >= 0
    fn indexOf(value: T) -> Int {
        for i in 0..count {
            if items[i] == value { return i }
        }
        return -1
    }

    fn copy() -> List<T> {
        out := List<T>()
        for x in this { out.add(x) }
        return out
    }
    fn reversed() -> List<T> {
        out := List<T>()
        for i in 0..count { out.add(items[count - 1 - i]) }
        return out
    }
    // The elements from `from` up to (not including) `to`: xs[from..to].
    fn slice(from: Int, to: Int) -> List<T> {
        if from < 0 || to > count || from > to {
            panic("slice bounds [$from..$to] are out of range for size $count")
        }
        out := List<T>()
        for i in from..to { out.add(items[i]) }
        return out
    }
    fn take(n: Int) -> List<T> {
        out := List<T>()
        for i in 0..count {
            if i < n { out.add(items[i]) }
        }
        return out
    }
    fn drop(n: Int) -> List<T> {
        out := List<T>()
        for i in n..count { out.add(items[i]) }
        return out
    }

    fn forEach(f: (T) -> Unit) {
        for i in 0..count { f(items[i]) }
    }
    fn map<R>(f: (T) -> R) -> List<R> {
        out := List<R>()
        for i in 0..count { out.add(f(items[i])) }
        return out
    }
    fn filter(keep: (T) -> Bool) -> List<T> {
        out := List<T>()
        for i in 0..count {
            if keep(items[i]) { out.add(items[i]) }
        }
        return out
    }
    // Pairs up the elements of two lists, as long as the shorter one: [(1, "a"), (2, "b")].
    fn zip<U>(other: List<U>) -> List<(T, U)> {
        out := List<(T, U)>()
        n := count
        if other.count < n { n = other.count }
        for i in 0..n { out.add((items[i], other.items[i])) }
        return out
    }
    // The first elements, so that `a, b := list` works.
    fn component1() -> T = get(0)
    fn component2() -> T = get(1)
    fn component3() -> T = get(2)
    fn component4() -> T = get(3)
    fn component5() -> T = get(4)
    fn fold<R>(initial: R, f: (R, T) -> R) -> R {
        acc := initial
        for i in 0..count { acc = f(acc, items[i]) }
        return acc
    }
    fn reduce(f: (T, T) -> T) -> T {
        if count == 0 { panic("reduce of an empty list") }
        acc := items[0]
        for i in 1..count { acc = f(acc, items[i]) }
        return acc
    }
    fn any(test: (T) -> Bool) -> Bool {
        for i in 0..count {
            if test(items[i]) { return true }
        }
        return false
    }
    fn all(test: (T) -> Bool) -> Bool {
        for i in 0..count {
            if !test(items[i]) { return false }
        }
        return true
    }
    fn count(test: (T) -> Bool) -> Int {
        n := 0
        for i in 0..count {
            if test(items[i]) { n += 1 }
        }
        return n
    }

    // A new list, sorted by `compare(a, b)`: negative if a goes first, positive if b does.
    // A stable merge sort (equal elements keep their order), O(n log n).
    fn sortedWith(compare: (T, T) -> Int) -> List<T> {
        n := count
        src := Array<T>(n)
        for i in 0..n { src[i] = items[i] }
        spare := Array<T>(n)
        width := 1
        while width < n {
            lo := 0
            while lo < n {
                mid := if lo + width < n { lo + width } else { n }
                hi := if lo + 2 * width < n { lo + 2 * width } else { n }
                i := lo
                j := mid
                k := lo
                while i < mid && j < hi {
                    if compare(src[j], src[i]) < 0 {
                        spare[k] = src[j]
                        j += 1
                    } else {
                        spare[k] = src[i]
                        i += 1
                    }
                    k += 1
                }
                while i < mid {
                    spare[k] = src[i]
                    i += 1
                    k += 1
                }
                while j < hi {
                    spare[k] = src[j]
                    j += 1
                    k += 1
                }
                lo += 2 * width
            }
            done := spare
            spare = src
            src = done
            width *= 2
        }
        out := List<T>()
        for i in 0..n { out.add(src[i]) }
        return out
    }

    // Ordered by compareTo (the elements must have one); sortedBy orders by a key.
    fn sorted() -> List<T> = sortedWith { a, b -> a.compareTo(b) }
    fn sortedDescending() -> List<T> = sortedWith { a, b -> b.compareTo(a) }
    fn sortedBy<K: Comparable<K>>(key: (T) -> K) -> List<T> = sortedWith { a, b -> key(a).compareTo(key(b)) }
    fn maxOrNull() -> T? {
        if count == 0 { return null }
        best := items[0]
        for i in 1..count {
            if items[i].compareTo(best) > 0 { best = items[i] }
        }
        return best
    }
    fn minOrNull() -> T? {
        if count == 0 { return null }
        best := items[0]
        for i in 1..count {
            if items[i].compareTo(best) < 0 { best = items[i] }
        }
        return best
    }

    fn join(separator: String = ", ") -> String {
        out := StringBuilder()
        for i in 0..count {
            if i > 0 { out.append(separator) }
            out.append("${items[i]}")
        }
        return out.toString()
    }
    fn toString() = "[" + join() + "]"
}

// Tuples: `(1, "a")` is a Tuple2<Int, String>, written `(Int, String)` in types.  Up to five
// elements; a value is taken apart with `a, b := pair` (through `component1()`, `component2()`, …).
type Tuple2<A, B>(first: A, second: B) {
    fn component1() = first
    fn component2() = second
    fn equals(other: Tuple2<A, B>) = first == other.first && second == other.second
    fn hashCode() = hashOf(first) * 31 % 1000003 + hashOf(second)
    fn toString() = "($first, $second)"
}

type Tuple3<A, B, C>(first: A, second: B, third: C) {
    fn component1() = first
    fn component2() = second
    fn component3() = third
    fn equals(other: Tuple3<A, B, C>) = first == other.first && second == other.second && third == other.third
    fn hashCode() = ((hashOf(first)) * 31 % 1000003 + hashOf(second)) * 31 % 1000003 + hashOf(third)
    fn toString() = "($first, $second, $third)"
}

type Tuple4<A, B, C, D>(first: A, second: B, third: C, fourth: D) {
    fn component1() = first
    fn component2() = second
    fn component3() = third
    fn component4() = fourth
    fn equals(other: Tuple4<A, B, C, D>) = first == other.first && second == other.second && third == other.third && fourth == other.fourth
    fn hashCode() = (((hashOf(first)) * 31 % 1000003 + hashOf(second)) * 31 % 1000003 + hashOf(third)) * 31 % 1000003 + hashOf(fourth)
    fn toString() = "($first, $second, $third, $fourth)"
}

type Tuple5<A, B, C, D, E>(first: A, second: B, third: C, fourth: D, fifth: E) {
    fn component1() = first
    fn component2() = second
    fn component3() = third
    fn component4() = fourth
    fn component5() = fifth
    fn equals(other: Tuple5<A, B, C, D, E>) = first == other.first && second == other.second && third == other.third && fourth == other.fourth && fifth == other.fifth
    fn hashCode() = ((((hashOf(first)) * 31 % 1000003 + hashOf(second)) * 31 % 1000003 + hashOf(third)) * 31 % 1000003 + hashOf(fourth)) * 31 % 1000003 + hashOf(fifth)
    fn toString() = "($first, $second, $third, $fourth, $fifth)"
}

// Each element with its position: `for i, x in enumerate(xs)`.
fn enumerate<T>(xs: List<T>) -> List<(Int, T)> {
    out := List<(Int, T)>()
    for i in 0..xs.size() { out.add((i, xs[i])) }
    return out
}

// A run of Ints: `1..5` (up to, not including, 5), `1..=5`, `(0..10) step 2`, `10 downTo 0`.  It can be
// looped over, tested with `in`, and used like a list of its numbers.  (`for i in a..b` itself does not
// build one.)
type Range(start: Int, end: Int, stride: Int = 1) {
    init {
        if stride == 0 { panic("a range cannot step by 0") }
    }

    fn size() -> Int {
        if stride > 0 {
            if end <= start { return 0 }
            return (end - start + stride - 1) / stride
        }
        if start <= end { return 0 }
        return (start - end - stride - 1) / (-stride)
    }
    fn isEmpty() = size() == 0
    fn get(index: Int) -> Int {
        if index < 0 || index >= size() { panic("index $index is out of bounds for a range of ${size()} numbers") }
        return start + index * stride
    }
    fn first() -> Int = get(0)
    fn last() -> Int = get(size() - 1)
    fn contains(x: Int) -> Bool {
        if stride > 0 { return x >= start && x < end && (x - start) % stride == 0 }
        return x <= start && x > end && (start - x) % (-stride) == 0
    }
    // Every n-th number: `(0..10).step(2)`, also written `0..10 step 2`.
    fn step(n: Int) -> Range {
        if n <= 0 { panic("a step must be positive") }
        return Range(start, end, stride * n)
    }
    fn reversed() -> Range {
        if size() == 0 { return Range(0, 0) }
        return Range(last(), start - (stride > 0 ? 1 : -1), -stride)
    }
    fn toList() -> List<Int> {
        out := List<Int>()
        n := size()
        for i in 0..n { out.add(start + i * stride) }
        return out
    }
    fn sum() -> Int {
        total := 0
        n := size()
        for i in 0..n { total += start + i * stride }
        return total
    }
    fn forEach(f: (Int) -> Unit) = toList().forEach(f)
    fn map<R>(f: (Int) -> R) -> List<R> = toList().map(f)
    fn filter(keep: (Int) -> Bool) -> List<Int> = toList().filter(keep)
    fn fold<R>(initial: R, f: (R, Int) -> R) -> R = toList().fold(initial, f)
    fn any(test: (Int) -> Bool) -> Bool = toList().any(test)
    fn all(test: (Int) -> Bool) -> Bool = toList().all(test)
    fn count(test: (Int) -> Bool) -> Int = toList().count(test)
    fn join(separator: String = ", ") = toList().join(separator)
    fn toString() = toList().toString()
}

// `10 downTo 1`: the numbers from 10 down to (and including) 1.
fn Int.downTo(end: Int) = Range(this, end - 1, -1)

// One key/value pair of a Map.
type Entry<K, V>(key: K, value: V) {
    fn component1() = key
    fn component2() = value
    fn toString() = "$key: $value"
}

// A hash map that remembers insertion order.  Keys are compared with `==`
// (objects by identity) and hashed by `hashOf`.
type Map<K, V> {
    keyArr: Array<K> = Array<K>(8)
    valArr: Array<V> = Array<V>(8)
    live: Array<Bool> = Array<Bool>(8)
    // open-addressing table of entry numbers; -1 is an empty slot
    table: Array<Int> = Array(16, -1)
    used: Int
    count: Int

    fn size() = count
    fn isEmpty() = count == 0

    // Entry number of `key`, or -1.
    fn find(key: K) -> Int {
        slot := hashOf(key) % table.size()
        while table[slot] != -1 {
            e := table[slot]
            if live[e] && keyArr[e] == key { return e }
            slot = (slot + 1) % table.size()
        }
        return -1
    }

    fn containsKey(key: K) = find(key) >= 0
    fn contains(key: K) = find(key) >= 0

    fn get(key: K) -> V {
        e := find(key)
        if e < 0 { panic("no such key: $key") }
        return valArr[e]
    }
    fn getOrNull(key: K) -> V? {
        e := find(key)
        if e < 0 { return null }
        return valArr[e]
    }
    fn getOr(key: K, fallback: V) -> V {
        e := find(key)
        if e < 0 { return fallback }
        return valArr[e]
    }

    fn set(key: K, value: V) {
        e := find(key)
        if e >= 0 {
            valArr[e] = value
            return
        }
        if used == keyArr.size() {
            capacity := keyArr.size()
            if count * 2 >= capacity { capacity *= 2 }
            rebuild(capacity)
        }
        keyArr[used] = key
        valArr[used] = value
        live[used] = true
        place(used)
        used += 1
        count += 1
    }

    // Is `key` there? Removes it and says whether it was.
    fn remove(key: K) -> Bool {
        e := find(key)
        if e < 0 { return false }
        live[e] = false
        keyArr.clear(e)
        valArr.clear(e)
        count -= 1
        return true
    }

    fn clear() {
        keyArr = Array<K>(8)
        valArr = Array<V>(8)
        live = Array<Bool>(8)
        table = Array(16, -1)
        used = 0
        count = 0
    }

    // Put entry `e` in the first free table slot after its hash.
    fn place(e: Int) {
        slot := hashOf(keyArr[e]) % table.size()
        while table[slot] != -1 { slot = (slot + 1) % table.size() }
        table[slot] = e
    }

    // Copy the live entries into fresh arrays with room for `capacity` entries.
    fn rebuild(capacity: Int) {
        oldKeys := keyArr
        oldVals := valArr
        oldLive := live
        oldUsed := used
        keyArr = Array<K>(capacity)
        valArr = Array<V>(capacity)
        live = Array<Bool>(capacity)
        table = Array(capacity * 2, -1)
        used = 0
        for i in 0..oldUsed {
            if oldLive[i] {
                keyArr[used] = oldKeys[i]
                valArr[used] = oldVals[i]
                live[used] = true
                place(used)
                used += 1
            }
        }
    }

    fn keys() -> List<K> {
        out := List<K>()
        for i in 0..used {
            if live[i] { out.add(keyArr[i]) }
        }
        return out
    }
    fn values() -> List<V> {
        out := List<V>()
        for i in 0..used {
            if live[i] { out.add(valArr[i]) }
        }
        return out
    }
    fn entries() -> List<Entry<K, V>> {
        out := List<Entry<K, V>>()
        for i in 0..used {
            if live[i] { out.add(Entry(keyArr[i], valArr[i])) }
        }
        return out
    }
    fn iter() = entries()

    fn forEach(f: (K, V) -> Unit) {
        for i in 0..used {
            if live[i] { f(keyArr[i], valArr[i]) }
        }
    }

    fn toString() = "{" + entries().join() + "}"
}

// A set of distinct values, in insertion order.
type Set<T> {
    members: Map<T, Bool> = Map<T, Bool>()

    fn size() = members.size()
    fn isEmpty() = members.isEmpty()
    fn contains(value: T) = members.containsKey(value)
    // Adds `value`; says whether it was new.
    fn add(value: T) -> Bool {
        had := members.containsKey(value)
        members.set(value, true)
        return !had
    }
    fn remove(value: T) = members.remove(value)
    fn clear() { members.clear() }
    fn toList() = members.keys()
    fn iter() = members.keys()
    fn toString() = "{" + members.keys().join() + "}"
}

// The distinct values of a list.  (A function rather than a List method:
// List's methods are declared whenever a List is, and one that mentioned Set
// would pull in Map, which mentions List again, for ever.)
fn setOf<T>(items: List<T>) -> Set<T> {
    out := Set<T>()
    for x in items { out.add(x) }
    return out
}

// ── Standard input ──────────────────────────────────────────────

// The next line of input without its line break, or null when the input has ended.
// Output printed so far is flushed first, so `print("name? ")` shows before it waits.
extern fn readLine() -> String? = "aion_read_line"
// All the remaining input as one String ("" if there is none).
extern fn readText() -> String = "aion_read_text"

// ── Program arguments ───────────────────────────────────────────

extern fn __argc() -> Int = "aion_argc"
extern fn __argv(index: Int) -> String = "aion_argv"

// The command-line arguments after the script: `aion script.aion a b` gives ["a", "b"].
fn args() -> List<String> {
    out := List<String>()
    for i in 0..__argc() { out.add(__argv(i)) }
    return out
}

// ── Tasks ───────────────────────────────────────────────────────
//
// Tasks are cooperative: they run one at a time and switch only when a task waits
// (join, await, a channel, sleep) or calls yield(), so no locks are needed.  A panic in a
// task that does not `try` it ends the program.  The program ends when the main code
// does, even if tasks are still going; use waitAll() to let them finish.

extern fn __spawn(body: () -> Unit) = "aion_spawn"
extern fn __park() = "aion_park"
extern fn __notify() = "aion_notify"
extern fn __taskCount() -> Int = "aion_task_count"

// Let the other tasks run for a while.
extern fn yield() = "aion_yield"
// Pause this task for `ms` milliseconds; the others keep running.
extern fn sleep(ms: Int) = "aion_sleep"

// A task that was started with launch { … }.
type Job {
    done: Bool = false
    fn isDone() = done
    // Wait for it to finish.
    fn join() {
        while !done { __park() }
    }
}

// Run `body` as a task, concurrently with the code that follows.
fn launch(body: () -> Unit) -> Job {
    job := Job()
    __spawn({
        body()
        job.done = true
        __notify()
    })
    return job
}

// A task that produces a value.
type Task<T> {
    slot: Array<T> = Array<T>(1)
    done: Bool = false
    fn isDone() = done
    // Wait for the result.
    fn await() -> T {
        while !done { __park() }
        return slot[0]
    }
}

// Run `body` as a task and get its result later with await().
fn async<T>(body: () -> T) -> Task<T> {
    task := Task<T>()
    __spawn({
        task.slot[0] = body()
        task.done = true
        __notify()
    })
    return task
}

// Wait until every task has finished.
fn waitAll() {
    while __taskCount() > 1 { __park() }
}

// A queue for passing values from one task to another.
//
//   Channel<T>()      a send waits until a receiver has taken the value
//   Channel<T>(10)    holds up to 10 values; a send waits only when it is full
//
// receive() waits for the next value and gives null once the channel is closed and empty.
type Channel<T>(capacity: Int = 0) {
    queue: List<T> = List<T>()
    closed: Bool = false
    sent: Int = 0
    taken: Int = 0

    fn size() = queue.size()
    fn isClosed() = closed

    fn send(value: T) {
        limit := if capacity > 0 { capacity } else { 1 }
        while !closed && queue.size() >= limit { __park() }
        if closed { panic("send on a closed channel") }
        queue.add(value)
        sent += 1
        ticket := sent
        __notify()
        if capacity == 0 {
            while !closed && taken < ticket { __park() }
        }
    }

    fn receive() -> T? {
        while queue.isEmpty() && !closed { __park() }
        if queue.isEmpty() { return null }
        value := queue.removeAt(0)
        taken += 1
        __notify()
        return value
    }

    // The next value if there is one right now, else null (it never waits).
    fn tryReceive() -> T? {
        if queue.isEmpty() { return null }
        value := queue.removeAt(0)
        taken += 1
        __notify()
        return value
    }

    // No more values will be sent; receivers get what is left, then null.
    fn close() {
        closed = true
        __notify()
    }

    // Handle each value until the channel is closed and empty.
    fn forEach(action: (T) -> Unit) {
        value := receive()
        while value != null {
            action(value)
            value = receive()
        }
    }

    // Everything that is sent from now on, until the channel is closed.
    fn drain() -> List<T> {
        out := List<T>()
        forEach { out.add(it) }
        return out
    }
}

// ── Support for `defer` and `try` (the compiler calls these; not for direct use) ──
extern fn __defer_push(action: () -> Unit) = "aion_defer_push"
extern fn __defer_mark() -> Int = "aion_defer_mark"
extern fn __defer_run(mark: Int) = "aion_defer_run"
extern fn __try(body: () -> Unit, handler: (String) -> Unit) = "aion_try"
// …and one per kind of result: the compiler passes closures returning that kind
extern fn __try_int(body: () -> Int, handler: (String) -> Int) -> Int = "aion_try_word"
extern fn __try_float(body: () -> Float, handler: (String) -> Float) -> Float = "aion_try_float"
extern fn __try_bool(body: () -> Bool, handler: (String) -> Bool) -> Bool = "aion_try_bool"
extern fn __try_ptr(body: () -> String, handler: (String) -> String) -> String = "aion_try_ptr"
