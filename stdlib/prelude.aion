// The prelude: names available in every Aion program without an import.
//
// Also built in, but not expressible as ordinary functions because they
// accept any printable type (Int, Float, Bool or String):
//
//   print(value)     write the value, no newline
//   println(value)   write the value and a newline
//   println()        write just a newline

// Stop the program with `[aion] panic: <message>` on stderr and exit code 1.
extern fn panic(message: String) = "aion_panic"
