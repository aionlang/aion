// Conway's Game of Life on a small wrapping grid: a glider walks across it.
// Shows a type with state, 2-D indexing with Arrays, and string building.
//
//   aion examples/game_of_life.aion

type Grid(width: Int, height: Int) {
    cells: Array<Bool> = Array(width * height, false)

    fn alive(x: Int, y: Int) -> Bool {
        // wrap around the edges
        col := (x + width) % width
        row := (y + height) % height
        return cells[row * width + col]
    }

    fn set(x: Int, y: Int, value: Bool) {
        cells[y * width + x] = value
    }

    fn neighbours(x: Int, y: Int) -> Int {
        count := 0
        for dy in -1..=1 {
            for dx in -1..=1 {
                if (dx != 0 || dy != 0) && alive(x + dx, y + dy) { count += 1 }
            }
        }
        return count
    }

    // The next generation: a live cell survives with 2 or 3 neighbours, a dead one is born with exactly 3.
    fn step() -> Grid {
        next := Grid(width, height)
        for y in 0..height {
            for x in 0..width {
                n := neighbours(x, y)
                next.set(x, y, if alive(x, y) { n == 2 || n == 3 } else { n == 3 })
            }
        }
        return next
    }

    fn population() -> Int {
        count := 0
        for y in 0..height {
            for x in 0..width {
                if alive(x, y) { count += 1 }
            }
        }
        return count
    }

    fn toString() -> String {
        out := StringBuilder()
        for y in 0..height {
            for x in 0..width {
                out.append(if alive(x, y) { "#" } else { "." })
            }
            if y < height - 1 { out.appendLine() }
        }
        return out.toString()
    }
}

// A glider: it moves one cell diagonally every four generations.
grid := Grid(8, 8)
for cell in [[1, 0], [2, 1], [0, 2], [1, 2], [2, 2]] {
    grid.set(cell[0], cell[1], true)
}

for generation in 0..=4 {
    println("generation $generation, population ${grid.population()}")
    println(grid)
    println()
    grid = grid.step()
}

// The loop above left us at generation 5.  Four generations move the glider one cell diagonally, so after
// 32 generations on an 8x8 wrapping grid it has travelled all the way round and looks like generation 0.
for i in 5..32 { grid = grid.step() }
println("generation 32, population ${grid.population()}")
println(grid)

