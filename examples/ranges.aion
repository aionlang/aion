// Ranges are values: `1..5` stops before 5, `1..=5` includes it, `step` and `downTo` set the pace.
// `for i in a..b` is still a plain counting loop; build a Range when you want the numbers as data.
//
//   aion examples/ranges.aion

r := 1..=5
println(r, r.size(), 3 in r, 9 in r)
println((1..=10).map { it * it })
println((1..=10).filter { it % 3 == 0 }, (1..=100).sum())

// counting with a pace
for i in 0..=20 step 5 { print(i, "") }
println()
for i in 10 downTo 7 { print(i, "") }
println()
for i in 10 downTo 0 step 4 { print(i, "") }
println()
println((1..=5).reversed())

// a range as an index list
names := ["ann", "bob", "cy", "di", "ed"]
println((0..names.size() step 2).map { names[it] })
println((1..4).map { names[it] })

// building things from ranges
squares := (1..=5).map { it * it }
println(squares, squares.fold(0) { acc, x -> acc + x })
table := (1..=3).map { row -> (1..=3).map { col -> row * col }.join(" ") }
for line in table { println(line) }
fizz := (1..=15).map { n -> n % 15 == 0 ? "FizzBuzz" : n % 5 == 0 ? "Buzz" : n % 3 == 0 ? "Fizz" : "$n" }
println(fizz.join(" "))

// pass one around, and ask it things
fn describe(r: Range) = "${r.size()} numbers from ${r.first()} to ${r.last()}"
println(describe(5..10))
println(describe(10 downTo 1 step 3))
println((1..0).isEmpty(), (1..0).size(), (5 downTo 1).count { it % 2 == 1 })

// > [1, 2, 3, 4, 5] 5 true false
// > [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]
// > [3, 6, 9] 5050
// > 0 5 10 15 20 
// > 10 9 8 7 
// > 10 6 2 
// > [5, 4, 3, 2, 1]
// > [ann, cy, ed]
// > [bob, cy, di]
// > [1, 4, 9, 16, 25] 55
// > 1 2 3
// > 2 4 6
// > 3 6 9
// > 1 2 Fizz 4 Buzz Fizz 7 8 Fizz Buzz 11 Fizz 13 14 FizzBuzz
// > 5 numbers from 5 to 9
// > 4 numbers from 10 to 1
// > true 0 3
