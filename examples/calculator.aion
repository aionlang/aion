// A calculator written from scratch: a tokenizer, a recursive-descent parser that builds a syntax tree of
// objects, and an evaluator.  Supports + - * / % ^, parentheses, unary minus, variables, assignment and a few
// functions.  Shows inheritance (the tree), recursion and error handling.
//
//   aion examples/calculator.aion              runs the built-in demo
//   aion examples/calculator.aion "2 * (3 + 4)" "x = 5" ...   evaluates the expressions you give

import math

// ── Tokens ──────────────────────────────────────────────────────

type Token(kind: String, text: String)       // kind: "num", "name", "op", "end"

fn tokenize(source: String) -> List<Token> {
    tokens := List<Token>()
    chars := source.chars()
    i := 0
    while i < chars.size() {
        c := chars[i]
        if c.isWhitespace() {
            i += 1
        } else if c.isDigit() || c == '.' {
            start := i
            while i < chars.size() && (chars[i].isDigit() || chars[i] == '.') { i += 1 }
            tokens.add(Token("num", chars.slice(start, i).map { it.toString() }.join("")))
        } else if c.isLetter() {
            start := i
            while i < chars.size() && (chars[i].isLetter() || chars[i].isDigit()) { i += 1 }
            tokens.add(Token("name", chars.slice(start, i).map { it.toString() }.join("")))
        } else if "+-*/%^()=,".contains(c.toString()) {
            tokens.add(Token("op", c.toString()))
            i += 1
        } else {
            panic("unexpected character '$c'")
        }
    }
    tokens.add(Token("end", ""))
    return tokens
}

// ── Syntax tree ─────────────────────────────────────────────────

// Every node can be evaluated; the variables live in a map.
open type Node {
    open fn eval(vars: Map<String, Float>) -> Float = 0.0
    open fn show() -> String = "?"
}

type Number(value: Float) : Node() {
    override fn eval(vars: Map<String, Float>) = value
    override fn show() = "$value"
}

type Variable(name: String) : Node() {
    override fn eval(vars: Map<String, Float>) -> Float {
        value := vars.getOrNull(name)
        if value == null { panic("unknown variable '$name'") }
        return value
    }
    override fn show() = name
}

type Negate(operand: Node) : Node() {
    override fn eval(vars: Map<String, Float>) = -operand.eval(vars)
    override fn show() = "(-${operand.show()})"
}

type Binary(op: String, left: Node, right: Node) : Node() {
    override fn eval(vars: Map<String, Float>) -> Float {
        a := left.eval(vars)
        b := right.eval(vars)
        return when op {
            "+" -> a + b
            "-" -> a - b
            "*" -> a * b
            "/" -> {
                if b == 0.0 { panic("division by zero") }
                a / b
            }
            "%" -> math.fmod(a, b)
            else -> math.pow(a, b)
        }
    }
    override fn show() = "(${left.show()} $op ${right.show()})"
}

type Call(name: String, args: List<Node>) : Node() {
    override fn eval(vars: Map<String, Float>) -> Float {
        values := args.map { it.eval(vars) }
        if name == "sqrt" && values.size() == 1 { return math.sqrt(values[0]) }
        if name == "abs" && values.size() == 1 { return values[0].abs() }
        if name == "max" && values.size() == 2 { return values[0].max(values[1]) }
        if name == "min" && values.size() == 2 { return values[0].min(values[1]) }
        if name == "sin" && values.size() == 1 { return math.sin(values[0]) }
        if name == "round" && values.size() == 1 { return values[0].round().toFloat() }
        panic("unknown function $name with ${values.size()} argument(s)")
    }
    override fn show() = "$name(${args.map { it.show() }.join(", ")})"
}

type Assign(name: String, value: Node) : Node() {
    override fn eval(vars: Map<String, Float>) -> Float {
        result := value.eval(vars)
        vars[name] = result
        return result
    }
    override fn show() = "$name = ${value.show()}"
}

// ── Parser ──────────────────────────────────────────────────────
//   statement := name "=" expression | expression
//   expression := term (("+" | "-") term)*
//   term       := power (("*" | "/" | "%") power)*
//   power      := unary ("^" power)?              (right-associative)
//   unary      := "-" unary | primary              (so -2 ^ 2 is (-2) ^ 2 = 4)
//   primary    := number | name | name "(" args ")" | "(" expression ")"

type Parser(tokens: List<Token>) {
    at: Int = 0

    fn peek() -> Token = tokens[at]
    fn next() -> Token {
        t := tokens[at]
        if at < tokens.size() - 1 { at += 1 }
        return t
    }
    fn isOp(text: String) = peek().kind == "op" && peek().text == text
    fn expect(text: String) {
        if !isOp(text) { panic("expected '$text' but found '${peek().text}'") }
        next()
    }

    fn statement() -> Node {
        if peek().kind == "name" && tokens[at + 1].kind == "op" && tokens[at + 1].text == "=" {
            name := next().text
            next()
            return Assign(name, expression())
        }
        return expression()
    }

    fn parseAll() -> Node {
        tree := statement()
        if peek().kind != "end" { panic("unexpected '${peek().text}'") }
        return tree
    }

    fn expression() -> Node {
        left := term()
        while isOp("+") || isOp("-") {
            op := next().text
            left = Binary(op, left, term())
        }
        return left
    }

    fn term() -> Node {
        left := power()
        while isOp("*") || isOp("/") || isOp("%") {
            op := next().text
            left = Binary(op, left, power())
        }
        return left
    }

    fn power() -> Node {
        base := unary()
        if isOp("^") {
            next()
            return Binary("^", base, power())
        }
        return base
    }

    fn unary() -> Node {
        if isOp("-") {
            next()
            return Negate(unary())
        }
        return primary()
    }

    fn primary() -> Node {
        t := next()
        if t.kind == "num" {
            value := t.text.toFloatOrNull()
            if value == null { panic("bad number '${t.text}'") }
            return Number(value)
        }
        if t.kind == "name" {
            if isOp("(") {
                next()
                args := List<Node>()
                if !isOp(")") {
                    args.add(expression())
                    while isOp(",") {
                        next()
                        args.add(expression())
                    }
                }
                expect(")")
                return Call(t.text, args)
            }
            return Variable(t.text)
        }
        if t.kind == "op" && t.text == "(" {
            inner := expression()
            expect(")")
            return inner
        }
        panic(if t.kind == "end" { "the expression ends too soon" } else { "unexpected '${t.text}'" })
    }
}

vars := Map<String, Float>()
vars["pi"] = math.pi

fn run(line: String) {
    message := try {
        tree := Parser(tokenize(line)).parseAll()
        value := tree.eval(vars)
        "${line.padRight(24)} = ${value.toString().padRight(18)} parsed as ${tree.show()}"
    } catch e {
        "${line.padRight(24)} ! $e"
    }
    println(message)
}

lines := args()
if lines.isEmpty() {
    lines = [
        "1 + 2 * 3", "(1 + 2) * 3", "2 ^ 3 ^ 2", "-2 ^ 2", "10 / 4", "10 % 4", "7 - 2 - 1",
        "x = 6", "y = x * 7", "x + y", "sqrt(144) + abs(-3)", "max(x, y) - min(x, y)",
        "r = 2", "pi * r ^ 2", "round(pi * 100)",
        "1 / 0", "2 +", "(1 + 2", "foo(1)", "unknown + 1", "3 $ 4", "1.2.3",
    ]
}
for line in lines { run(line) }

// > 1 + 2 * 3                = 7                  parsed as (1 + (2 * 3))
// > (1 + 2) * 3              = 9                  parsed as ((1 + 2) * 3)
// > 2 ^ 3 ^ 2                = 512                parsed as (2 ^ (3 ^ 2))
// > -2 ^ 2                   = 4                  parsed as ((-2) ^ 2)
// > 10 / 4                   = 2.5                parsed as (10 / 4)
// > 10 % 4                   = 2                  parsed as (10 % 4)
// > 7 - 2 - 1                = 4                  parsed as ((7 - 2) - 1)
// > x = 6                    = 6                  parsed as x = 6
// > y = x * 7                = 42                 parsed as y = (x * 7)
// > x + y                    = 48                 parsed as (x + y)
// > sqrt(144) + abs(-3)      = 15                 parsed as (sqrt(144) + abs((-3)))
// > max(x, y) - min(x, y)    = 36                 parsed as (max(x, y) - min(x, y))
// > r = 2                    = 2                  parsed as r = 2
// > pi * r ^ 2               = 12.566370614359172 parsed as (pi * (r ^ 2))
// > round(pi * 100)          = 314                parsed as round((pi * 100))
// > 1 / 0                    ! division by zero
// > 2 +                      ! the expression ends too soon
// > (1 + 2                   ! expected ')' but found ''
// > foo(1)                   ! unknown function foo with 1 argument(s)
// > unknown + 1              ! unknown variable 'unknown'
// > 3 $ 4                    ! unexpected character '$'
// > 1.2.3                    ! bad number '1.2.3'
