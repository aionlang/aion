// A type with a constructor, and methods added from outside the type with `fn Animal.method()`.

import math

type Animal {
    name: String
    age: Int

    constructor(name: String) {
        this.name = name
    }

    fn bark() -> String {
        return "Woof!"
    }
}

fn Animal.animalToString() -> String {
    return "Animal(${this.name}, ${this.age})"
}

fn Animal.setAge(age: Int) {
    this.age = age
}

fn main() {
    a := Animal("Fido")
    a.setAge(5)
    println(a.animalToString())
    println(a.bark())
    println("sqrt(2) = ${math.sqrt(2)}")
}

// > Animal(Fido, 5)
// > Woof!
// > sqrt(2) = 1.4142135623730951
