// The Mandelbrot set drawn with characters: Float arithmetic, nested loops and a lookup string.
//
//   aion examples/mandelbrot.aion

// How many steps until z = z² + c escapes (|z| > 2)?  Points that never escape belong to the set.
fn escapeTime(cr: Float, ci: Float, limit: Int) -> Int {
    zr := 0.0
    zi := 0.0
    for step in 0..limit {
        if zr * zr + zi * zi > 4.0 { return step }
        next := zr * zr - zi * zi + cr
        zi = 2.0 * zr * zi + ci
        zr = next
    }
    return limit
}

shades := " .:-=+*%#"
width := 64
height := 24
limit := 60

inside := 0
for row in 0..height {
    line := StringBuilder()
    for col in 0..width {
        // map the character cell to a point of the complex plane
        cr := -2.2 + 3.2 * col.toFloat() / width.toFloat()
        ci := -1.2 + 2.4 * row.toFloat() / (height - 1).toFloat()
        steps := escapeTime(cr, ci, limit)
        if steps == limit {
            line.append("@")
            inside += 1
        } else {
            line.appendChar(shades[steps.min(8)])
        }
    }
    println(line)
}
println("$inside of ${width * height} cells are inside the set")

