// os on Windows: environment, processes and running other programs through cmd
// exit: 7
import os

println(os.env("AION_TEST_UNSET_VARIABLE"), os.setEnv("AION_TEST_VAR", "hello world"), os.env("AION_TEST_VAR"))
println(os.environment()["AION_TEST_VAR"], os.environment().containsKey("AION_TEST_UNSET_VARIABLE"))
println(os.unsetEnv("AION_TEST_VAR"), os.env("AION_TEST_VAR"))
println(os.pid() > 0, os.cpuCount() >= 1, os.platform(), os.arch().length() > 0, os.hostname().length() >= 0)

r := os.shell("echo out& echo err 1>&2& exit /b 3")
println(r.status, r.stdout.trim(), r.stderr.trim(), r.ok())
println(os.exec("cmd", ["/c", "echo", "a b"]).stdout.trim())
println(os.shell("echo shout", "").stdout.trim(), os.shell("exit /b 0").ok())
missing := os.exec("aion-no-such-program-xyz")
println(missing.status, missing.stderr.length() > 0)
os.setEnv("AION_TEST_CHILD", "inherited")
println(os.shell("echo %AION_TEST_CHILD%").stdout.trim())

println("before")
println(os.run("cmd", ["/c", "echo from child"]), os.run("cmd", ["/c", "exit 4"]), os.run("aion-no-such-program-xyz"))
println("after")
os.exit(7)
