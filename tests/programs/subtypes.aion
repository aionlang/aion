// A subtype can be used where its parent type is expected
open type Animal(name: String) {
    fn describe() = "animal $name"
}
open type Dog(name: String) : Animal(name)
type Cat(name: String) : Animal(name)
type Puppy(name: String) : Dog(name)
type Rock(name: String)

fn intro(a: Animal) = "this is ${a.describe()}"
a: Animal = Dog("Rex")
println(intro(a), intro(Cat("Tom")), intro(Puppy("Bit")))

pets: List<Animal> = [Dog("a"), Cat("b"), Puppy("c")]
println(pets.map { it.name })
pick := if pets.size() > 2 { Dog("x") } else { Cat("y") }     // their common parent
println(pick.describe())
maybe: Animal? = Cat("z")
println(maybe?.name)
d: Dog = Puppy("p")
println(d.name, d == d, a == a)
println(d == a, a == d, d != a)
