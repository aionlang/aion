// User-defined types: constructors, methods, fields, reference semantics.

type Point(it.x, it.y) {
    x: Int
    y: Int

    fn sum() -> Int => it.x + it.y
    fn scaled(k: Int) -> Point => Point(it.x * k, it.y * k)
}

type Counter {
    count: Int
    label: String

    constructor(label: String) {
        it.label = label
    }

    fn inc() {
        it.count += 1
    }

    fn show() -> String {
        return "${it.label}=${it.count}"
    }
}

fn Counter::reset() {
    it.count = 0
}

fn Counter::add(n: Int) -> Counter {
    it.count += n
    return it
}

type Line {
    a: Point
    b: Point

    fn length2() -> Int {
        dx := it.b.x - it.a.x
        dy := it.b.y - it.a.y
        return dx * dx + dy * dy
    }
}

type Defaults {
    i: Int
    f: Float
    b: Bool
    s: String
}

fn bump(c: Counter) {
    c.inc()
}

fn main() {
    p := Point(3, 4)
    println(p.sum())
    println(p.x)
    q := p.scaled(2)
    println("${q.x},${q.y}")

    c := Counter("hits")
    c.inc()
    c.inc()
    println(c.show())
    bump(c)
    println(c.show())

    alias := c
    alias.inc()
    println(c.show())
    println(alias == c)
    println(Counter("other") == c)

    c.reset()
    println(c.show())
    println(c.add(5).add(2).show())

    l := Line(Point(0, 0), Point(3, 4))
    println(l.length2())
    l.b.x = 6
    l.b.y += 8
    println(l.length2())
    println(l.b.sum())

    d := Defaults(0, 0.0, false, "")
    d2 := Counter("x")
    println("[${d2.label}] [${d2.count}]")
    println("${d.i} ${d.f} ${d.b} [${d.s}]")

    p.x = 10
    p.x -= 1
    println(p.x)
}
