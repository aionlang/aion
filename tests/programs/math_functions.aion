// import math: constants, powers, logarithms, trigonometry
import math

println(math.pi, math.tau, math.e)
println(math.inf, -math.inf, math.nan.isNaN(), math.nan == math.nan, math.inf > 1e308)
println(math.sqrt(2.0).format(6), math.cbrt(27.0), math.hypot(3.0, 4.0), math.pow(2.0, 0.5).format(4))
println(math.exp(0.0), math.log(math.e), math.log2(8.0), math.log10(1000.0), math.log(0.0), math.log(-1.0).isNaN())
println(math.sin(0.0), math.cos(0.0), math.tan(0.0), math.atan(1.0).format(4), math.atan2(1.0, 1.0).format(4))
println(math.asin(1.0).format(4), math.acos(1.0), math.sinh(0.0), math.cosh(0.0), math.tanh(0.0))
println(math.round(2.5), math.round(-2.5), math.trunc(-2.7), math.floor(-2.5), math.ceil(-2.5), math.fmod(7.5, 2.0), math.fmod(-7.5, 2.0))
println(math.toDegrees(math.pi), math.toRadians(180.0).format(5), math.toRadians(90.0).format(5))
println(math.abs(-2.5), math.fmax(1.0, 2.0), math.fmin(1.0, 2.0), math.max(3, 9), math.min(3, 9))
