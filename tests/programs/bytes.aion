// Bytes: raw byte strings, with equality, hashing and conversion
b := Bytes(4)
b[0] = 255
b[3] = 16
b[1] += 7
println(b, b.size())
println(b == bytesOf([255, 7, 0, 16]), b != Bytes(4), b == b[0..4])

s := "héllo".toBytes()
println(s.size(), s.toText(), s[1..3], s.toHex())
println(s.toHex().fromHex() == s, "zz".fromHex() == null, "abc".fromHex() == null)
println("6869".fromHex() ?: Bytes(0), "6869".fromHex()!!.toText())

total := 0
for x in bytesOf([1, 2, 3]) {
    total += x
}
println(total, 2 in bytesOf([1, 2, 3]), b.indexOf(16), b.indexOf(16, 4), b.contains(7))

m := Map<Bytes, Int>()
m[bytesOf([1, 2])] = 5
m[bytesOf([1, 2])] += 1
println(m[bytesOf([1, 2])], m.size(), hashOf(bytesOf([1, 2])) == hashOf(bytesOf([1, 2])))

println((s + b).size(), (b + Bytes(0)) == b, Bytes(2, 7), Bytes(0))

type Packet(data: Bytes) {
    fn first() = data[0]
    fn describe() = "packet of ${data.size()}"
}
p := Packet(bytesOf([9, 8]))
println(p.first(), p.describe(), p)

unset: Bytes
println(unset.size(), unset == Bytes(0))

// Many allocations under the collector.
keep := List<Bytes>()
for i in 0..200 {
    keep.add(Bytes(i % 17 + 1, i % 256))
}
sum := 0
for k in keep {
    sum += k[0] + k.size()
}
println(sum)

// searching and collecting
hay := "GET /index HTTP/1.1\r\nHost: x\r\n\r\nbody".toBytes()
sep := "\r\n\r\n".toBytes()
at := hay.find(sep)
println(at, hay.find(sep, at + 1), hay.find("Host".toBytes()), hay.find(Bytes(0), 3), hay.find(Bytes(0), 999), hay.find("zzz".toBytes()))
println(hay.startsWith("GET".toBytes()), hay.startsWith("POST".toBytes()), Bytes(2).startsWith(Bytes(3)), hay.slice(at + 4, hay.size()).toText())
bb := BytesBuilder()
for i in 0..300 {
    bb.addByte(i % 256)
}
bb.add("abc".toBytes()).addText("def")
println(bb.size(), bb.toBytes().size(), bb.toBytes().slice(298, 306).toHex(), bb)
bb.dropFirst(298)
println(bb.toBytes().toHex(), bb.isEmpty())
bb.clear()
println(bb.size(), bb.toBytes() == Bytes(0))
