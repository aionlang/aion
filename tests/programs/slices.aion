// exit: 1
// stderr: slice bounds [2..9] are out of range for size 5
// Slices of lists and strings
xs := [10, 20, 30, 40, 50]
println(xs[1..3], xs[..2], xs[3..], xs[..], xs[1..=3], xs[xs.size() - 2..])
println(xs[1..4][1], xs[1..4].size(), xs[0..0], xs[0..0].isEmpty())
s := "hello world"
println(s[0..5], s[6..], s[..=4], s[..], s[2..2] == "")
words := "the quick brown fox".split(" ")
println(words[1..3], words[2..].join("+"))
println(xs[2..9])
