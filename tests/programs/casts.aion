/**
 * `value as Type` converts between the basic types where you say so (an `Int` is never turned into a
 * `Float` behind your back, except where a `Float` is expected):
 *
 *   Int -> Float, Bool, String, Char       Float -> Int (drops the fraction), String
 *   Char -> Int, String                    Bool -> Int, String
 *   String -> Int, Float, Bool             (stops the program if the text does not read as one)
 *
 * `value as? Type` gives `null` instead of stopping, so `"12" as? Int` is `12` and `"x" as? Int` is `null`.
 * The same two forms take a value out of an `Any` and cast objects to a subtype.
 */
open type Animal(name: String)
type Dog(name: String) : Animal(name)

fn main() {
    n := 7
    x := 2.75
    println(n as Float, x as Int, -x as Int)
    println('A' as Int, 66 as Char, true as Int, 0 as Bool, 5 as Bool)
    println(n as String, x as String, true as String, 'z' as String, "same" as String)
    println("42" as Int, "2.5" as Float, "true" as Bool, "false" as Bool)
    println("42" as? Int, "x" as? Int, "2.5" as? Float, "nope" as? Float, "yes" as? Bool, "true" as? Bool)
    println(n as? Float, x as? Int, 3 as? Int)
    println(3.0 as Float, 'c' as Char)

    // a cast is an expression like any other
    total := ("40" as Int) + ("2" as Int)
    println(total, (total as Float) / 8.0)

    // objects: down to a subtype
    pet: Animal = Dog("Rex")
    println((pet as Dog).name, pet as? Dog, (Animal("Tom") as? Dog) == null)
}
