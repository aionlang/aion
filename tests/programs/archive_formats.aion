/** std.archive: archives made by `zip` and `tar` are read, archives of every format round-trip, a folder is packed, and a hostile archive is refused. */
import archive
import fs

// made with `zip -r tools.zip hello.txt docs` and `tar -czf tools.tar.gz hello.txt docs`
zipHex := ""
tgzHex := ""

dir := fs.makeTempDir("aionarchive")!!
zipFile := dir + "/tools.zip"
tgzFile := dir + "/tools.tar.gz"
fs.writeBytes(zipFile, zipHex.fromHex()!!)
fs.writeBytes(tgzFile, tgzHex.fromHex()!!)

for file in [zipFile, tgzFile] {
    println("--", file.substring(dir.length() + 1, file.length()))
    for e in archive.list(file)!! { println(e.kind, e.name, e.size) }
    println(archive.readText(file, "hello.txt"), archive.readText(file, "docs/notes.md")?.length(), archive.read(file, "nope"), archive.lastError())
    println(archive.read(file, "docs"), archive.lastError())
    out := dir + "/out_" + file.substring(dir.length() + 1, file.indexOf("."))
    println(archive.extract(file, out), fs.readText(out + "/docs/notes.md")?.startsWith("second file"), fs.readText(out + "/hello.txt"))
}
println(archive.list(dir + "/missing.zip"), archive.lastError().startsWith("cannot open"))
fs.writeText(dir + "/junk.zip", "this is not an archive at all, just some text")
println(archive.list(dir + "/junk.zip") == null)

// every format we can write, read back
files := Map<String, Bytes>()
files["a.txt"] = "alpha".toBytes()
files["dir/"] = Bytes(0)
pattern := Bytes(3000)
for i in 0..pattern.size() { pattern[i] = i % 251 }
files["dir/b.bin"] = pattern
files["caf\u{e9}.txt"] = "unicode name".toBytes()
files["empty.txt"] = Bytes(0)
for extension in ["zip", "7z", "tar", "tar.gz", "tgz", "tar.bz2", "tar.xz", "tar.zst"] {
    file := dir + "/made." + extension
    made := archive.create(file, files, 1700000000)
    if !made {
        println(extension, "not written:", archive.lastError())
        continue
    }
    entries := archive.list(file)!!
    names := entries.map { "${it.name}:${it.size}" }.sorted()
    same := archive.read(file, "dir/b.bin") == pattern && archive.readText(file, "a.txt") == "alpha" && archive.readText(file, "caf\u{e9}.txt") == "unicode name"
    println(extension, names, same, entries[0].isFile(), entries.filter { it.isFolder() }.size())
    if extension == "tar" { println(entries[0].modified, entries[0].mode) }
}
unpacked := dir + "/unpacked"
println(archive.extract(dir + "/made.tar.gz", unpacked), fs.readBytes(unpacked + "/dir/b.bin") == pattern, fs.isDir(unpacked + "/dir"), fs.size(unpacked + "/empty.txt"))

// pack a folder
site := dir + "/site"
fs.mkdirs(site + "/css")
fs.writeText(site + "/index.html", "<h1>hi</h1>")
fs.writeText(site + "/css/style.css", "body { color: red }")
for extension in ["zip", "tar.gz"] {
    file := dir + "/site." + extension
    println(archive.pack(file, site), archive.list(file)!!.map { it.name })
    again := dir + "/again_" + extension.substring(0, 3).replace(".", "")
    println(archive.extract(file, again), fs.readText(again + "/css/style.css"))
}
println(archive.pack(dir + "/x.rar", site), archive.lastError().startsWith("cannot tell the format"))
println(archive.create(dir + "/x.unknown", files), archive.lastError().startsWith("cannot tell the format"))

// names that would leave the folder, in an archive made by someone else
hostile := Map<String, Bytes>()
hostile["fine.txt"] = "ok".toBytes()
hostile["../evil.txt"] = "gotcha".toBytes()
println(archive.create(dir + "/hostile.zip", hostile), archive.lastError())
println(archive.create(dir + "/hostile.zip", hostile, allowUnsafeNames: true))
safe := dir + "/safe"
println(archive.extract(dir + "/hostile.zip", safe), archive.lastError().startsWith("the archive has an unsafe name"))
println(fs.exists(dir + "/evil.txt"), fs.exists(safe + "/evil.txt"))
absolute := Map<String, Bytes>()
absolute["/tmp/aion_should_not_exist.txt"] = "x".toBytes()
archive.create(dir + "/absolute.tar", absolute, allowUnsafeNames: true)
println(archive.extract(dir + "/absolute.tar", dir + "/abs"), fs.exists("/tmp/aion_should_not_exist.txt"))

// a limit on what an archive may expand to
bomb := Map<String, Bytes>()
bomb["zeros"] = Bytes(1000000)
archive.create(dir + "/bomb.zip", bomb)
println(archive.extract(dir + "/bomb.zip", dir + "/bomb", 1000), archive.lastError())
println(archive.extract(dir + "/bomb.zip", dir + "/bomb", 2000000), archive.read(dir + "/bomb.zip", "zeros", 1000), archive.lastError())
fs.removeAll(dir)
