/** More assertions: `assertNe assertFalse assertNull assertNotNull assertClose assertContains assertFails`. */
assertNe(1 + 1, 3)
assertFalse(1 > 2)
none: Int? = null
noText: String? = null
assertNull(none)
n: Int? = 4
assertNotNull(n)
assertClose(0.1 + 0.2, 0.3)
assertClose(2.5, 2.4, 0.2)
assertContains([1, 2, 3], 2)
assertContainsText("hello world", "o w")

msg := assertFails { 10 / (1 - 1) }
println(msg)
println(assertFails { panic("custom") })
println(assertFails { assertEq(1, 2, "numbers") })
println(assertFails { assertNe("a", "a") })
println(assertFails { assertClose(1.0, 2.0) })
println(assertFails { assertContains([1], 5) })
println(assertFails { assertContainsText("abc", "z") })
println(assertFails { assertNull(n) })
println(assertFails { assertNotNull(noText) })
println(assertFails { assertFails { println("fine") } })
