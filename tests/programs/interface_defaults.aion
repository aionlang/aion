// Interface default methods: a method with a body is used by types that do not have one of that name.
interface Shape {
    fn area() -> Float
    fn name() -> String
    fn describe() -> String = "${name()} with area ${area()}"
    fn banner() {
        println("== ${describe()} ==")
    }
}

type Circle(r: Float) {
    fn area() = 3.0 * r * r
    fn name() = "circle"
}
type Square(s: Float) {
    fn area() = s * s
    fn name() = "square"
    fn describe() = "a square of side $s"       // replaces the default
}

shapes: List<Shape> = [Circle(1.0), Square(2.0)]
for s in shapes {
    println(s.describe())
    s.banner()
}

interface Pair<T> {
    fn first() -> T
    fn second() -> T
    fn swapped() -> List<T> = [second(), first()]
}
type P(a: Int, b: Int) {
    fn first() = a
    fn second() = b
}
p: Pair<Int> = P(1, 2)
println(p.swapped())

fn total<T: Shape>(items: List<T>) = items.fold(0.0) { acc, s -> acc + s.area() }
println(total([Circle(1.0), Circle(2.0)]))

// A default can call another default and use `this`
interface Counter {
    fn value() -> Int
    fn doubled() -> Int = this.value() * 2
    fn quadrupled() -> Int = doubled() * 2
}
type Fixed(n: Int) { fn value() = n }
c: Counter = Fixed(5)
println(c.doubled(), c.quadrupled())
