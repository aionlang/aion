/** std.bigint: numbers of any size (GMP), checked against values worked out with Python. */
import bigint

a := bigint.parse("123456789012345678901234567893")!!
b := bigint.of(2).pow(100)
println(a, b)
println(a + b, a - b, a * b)
println(a / 7, a % 7, -a / 7, -a % 7)
println(a.floorDiv(bigint.of(-7)), a.mod(bigint.of(-7)), (-a).floorDiv(bigint.of(7)), (-a).mod(bigint.of(7)))
println(a + 5, 5 + a, a * 2, 2 * a, 1000000000000 - a, a > 5, 5 < a, a.compareTo(a), a == bigint.parse("123456789012345678901234567893"))
println(bigint.factorial(30), bigint.factorial(0), bigint.fibonacci(100), bigint.fibonacci(0))
println((a * a).sqrt(), a.sqrt(), bigint.of(1000000).pow(5).root(5), bigint.of(10).pow(30).root(3))
println(bigint.of(48).gcd(bigint.of(180)), bigint.of(4).lcm(bigint.of(6)), bigint.of(-12).gcd(bigint.of(18)))
println(bigint.of(7).modPow(bigint.of(128), bigint.of(13)), bigint.of(2).modPow(bigint.of(1000), bigint.of(1000000007)))
println(bigint.of(3).modInverse(bigint.of(11)), bigint.of(6).modInverse(bigint.of(9)), bigint.of(3).modPow(bigint.of(-1), bigint.of(11)))
println(bigint.of(10).choose(3), bigint.of(52).choose(5))
println(bigint.of(97).isProbablePrime(), bigint.of(91).isProbablePrime(), bigint.of(2).pow(61).minus(1).isProbablePrime(), bigint.of(-7).isProbablePrime(), bigint.of(1).isProbablePrime())
println(bigint.of(100).nextPrime(), bigint.of(2).pow(64).nextPrime())
println(bigint.of(12).and(bigint.of(10)), bigint.of(12).or(bigint.of(10)), bigint.of(12).xor(bigint.of(10)), bigint.of(12).not(), bigint.of(-12).and(bigint.of(10)))
println(bigint.of(1).shl(70), bigint.of(1).shl(70).shr(68), bigint.of(-5).shr(1), bigint.of(255).bitLength(), bigint.of(0).bitLength(), bigint.of(2).pow(100).bitLength())
println(bigint.of(255).toRadix(16), bigint.of(-255).toRadix(2), bigint.parse("ff", 16)!!, bigint.parse("-1010", 2)!!, bigint.parse("zz", 36)!!)
println(bigint.parse("12x"), bigint.parse(""), bigint.parse("  42  "), bigint.parse("+7"), bigint.parse("-0"))
println(bigint.of(42).toInt(), bigint.of(2).pow(70).toInt(), bigint.of(-9223372036854775807).toInt(), bigint.of(2).pow(70).toFloat(), bigint.ofFloat(1.0e20), bigint.ofFloat(-2.9))
println(bigint.of(0).isZero(), bigint.of(5).isNegative(), bigint.of(-5).isNegative(), bigint.of(-5).abs(), bigint.of(-5).signum(), bigint.of(0).signum(), bigint.of(4).isEven(), bigint.of(7).isEven())
println(bigint.max(bigint.of(3), bigint.of(9)), bigint.min(bigint.of(3), bigint.of(9)), bigint.of(7).hashCode() == bigint.parse("7")!!.hashCode())
total := bigint.zero
for i in 1..=100 { total += i * i }
println(total, total == bigint.of(338350))
prod := bigint.one
for i in 1..=25 { prod *= i }
println(prod == bigint.factorial(25), prod)
println(assertFails { a / 0 }, assertFails { bigint.of(1) % bigint.zero }, assertFails { bigint.of(-4).sqrt() }, assertFails { bigint.factorial(-1) })

// fractions
half := bigint.rational(1, 2)
third := bigint.rational(1, 3)
println(half + third, half - third, half * third, half / third, -half, half.inverse(), bigint.rational(6, -8), bigint.rational(4, 2), bigint.rational(0, 5))
println(half < third, third < half, half == bigint.rational(2, 4), half + 1, half * 4, half - 1, half / 2)
println(bigint.rational(7, 2).floor(), bigint.rational(7, 2).ceil(), bigint.rational(-7, 2).floor(), bigint.rational(-7, 2).ceil(), bigint.rational(3, 4).toFloat(), bigint.rational(5, 1).isInteger())
println(half.pow(3), half.pow(-3), bigint.rational(-2, 3).abs())
sum := bigint.rational(0, 1)
for i in 1..=10 { sum += bigint.rational(1, i) }
println(sum, sum.toFloat() > 2.9289 && sum.toFloat() < 2.929)
println(assertFails { bigint.rational(1, 0) }, assertFails { bigint.rational(0, 1).inverse() })
