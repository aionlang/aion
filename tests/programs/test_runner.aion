// exit: 1
/** `test.run` keeps going after a failed test; `test.summary` prints the totals and stops with status 1. */
import test

test.run("passes") { assertEq(1 + 1, 2) }
test.run("fails") { assertEq(1 + 1, 3, "sum") }
test.run("panics") { println(10 / (1 - 1)) }
test.skip("later")
test.run("raises") { assertFails { panic("x") } }
println("failed so far:", test.failed())
test.summary()
println("not reached")
