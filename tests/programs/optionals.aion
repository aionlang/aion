// Optional types: T?, null, boxing of Int?/Float?/Bool?, printing.

a: Int? = 5
b: Int? = null
c: String? = "hi"
d: String? = null
e: Float? = 2
f: Bool? = false
println(a, b, c, d, e, f)
println(null)

type Node(value: Int) {
    next: Node?
    tag: String?
}
n := Node(1)
println(n)
n.next = Node(2)
n.tag = "x"
println(n.next, n.tag)

fn maybe(flag: Bool) -> Int? = if flag { 42 } else { null }
println(maybe(true), maybe(false))
fn describe(x: String?) = "got $x"
println(describe("a"), describe(null))

xs: List<Int?> = [1, null, 3]
println(xs, xs.size())
m := Map<String, Int?>()
m["a"] = 1
m["b"] = null
println(m)

// an if may mix a value and null
g := if xs.size() > 2 { "set" } else { null }
println(g)
words := Array<String?>(2)
words[1] = "x"
println(words[0], words[1])

// ── comparing with null and with values ──
p: Int? = 5
q: Int? = null
println(p == null, p != null, q == null, null == q, null == null, null != null)
println(p == 5, p == 6, q == 5, 5 == p, p != 5, q != 5)
k: Int? = 5
println(p == k, p == q, q == q, q != p)
fl: Float? = 2
println(fl == 2, fl == 2.5)
s2: String? = "x"
t2: String? = null
println(s2 == "x", s2 == "y", t2 == "x", s2 == t2, t2 == t2, t2 == null)
type N(v: Int)
n2: N? = N(1)
m2: N? = null
println(n2 == null, m2 == null, n2 == n2, n2 == m2)
plain := N(2)
println(plain == null, plain != null)
ys: List<String?> = ["p", null]
println(ys.contains(null), ys.contains("p"), ys.contains("z"), ys.indexOf(null))
r := when (q) {
    null -> "none"
    else -> "some"
}
println(r)
